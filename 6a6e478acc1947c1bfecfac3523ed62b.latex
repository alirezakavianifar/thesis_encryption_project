}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957752}{}{}\RL{تحلیل و تفسیر نتایج تجربی}
\end{enumerate}

\RL{در این بخش، نتایج به‌دست‌آمده از پیاده‌سازی الگوریتم پیشنهادی بر روی
مجموعه داده} USC-SIPI \RL{مورد بررسی و تحلیل دقیق قرار می‌گیرد. هدف اصلی
این تحلیل، اثبات اعتبار فرضیه‌های تحقیق و ارائه استدلال‌های فنی مبتنی بر
داده‌های کمی و بصری است}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \textbf{\RL{معکوس‌پذیری و صحت رمزگشایی}:} \RL{همان‌طور که در شکل‌های ۴-۱
  تا ۴-۱۲ مشاهده شد، تصاویر رمزگشایی‌شده کاملاً برابر با تصاویر اصلی هستند
  و} PSNR \RL{آن‌ها برابر ∞ است. این نشان می‌دهد که الگوریتم به‌صورت کاملاً
  معکوس‌پذیر عمل می‌کند و هیچ افت اطلاعاتی در فرآیند رمزگذاری ایجاد
  نمی‌شود}.
\item
  \textbf{\RL{تحلیل هیستوگرام و توزیع آماری}:} \RL{هیستوگرام تصاویر رمز
  شده (شکل‌های ۴-۱۳ تا ۴-16) نشان‌دهنده یک توزیع تقریباً یکنواخت و بدون
  تمرکز است. این تغییر از حالت چندقلومی و متمرکز در تصاویر اصلی به توزیع
  یکنواخت، بیانگر موفقیت الگوریتم در ایجاد آماری تصادفی و کاهش الگوهای
  قابل پیش‌بینی است. این تحلیل مستقیماً فرضیه ۵ را تأیید می‌کند}.
\item
  \textbf{\RL{آنتروپی اطلاعات}:} \RL{مطابق جدول ۴-۱، میانگین آنتروپی
  تصاویر رمز شده ۷.۹۷۸۹ بیت است که بسیار نزدیک به مقدار حداکثر (۸ بیت)
  است. این افزایش آنتروپی ناشی از انتخاب تصادفی نقشه آشوبی برای هر پیکسل
  است و نشان‌دهنده غیرقابل پیش‌بینی بودن و امنیت بالای الگوریتم (فرضیه ۳)
  می‌باشد}.
\item
  \textbf{\RL{کاهش همبستگی پیکسل‌های مجاور}:} \RL{همان‌طور که در جدول ۴-۲
  مشاهده می‌شود، همبستگی میان پیکسل‌های مجاور به کمتر از ۰.۰۵٪ کاهش یافته
  است که بیانگر شکستن ساختار مکانی تصویر و عملکرد موفق سیستم چن در
  جایگشت پیکسل‌ها است. این تحلیل تأیید قاطع فرضیه ۲ محسوب می‌شود}.
\item
  \textbf{\RL{حساسیت به کلید و اثر دیفرانسیلی}:} \RL{مقادیر} NPCR \RL{و}
  UACI \RL{در جدول ۴-۳ نشان می‌دهند که تغییر یک بیت در کلید یا تصویر
  اصلی، بیش از ۹۹.۶٪ پیکسل‌ها را تحت تأثیر قرار می‌دهد و میانگین تغییر شدت
  پیکسل‌ها حدود ۳۲٪ است. این نتایج بیانگر قدرت اثر} Avalanche \RL{و
  مقاومت بالا در برابر حملات دیفرانسیلی است}.
\item
  \textbf{\RL{زمان اجرا و کارایی محاسباتی}:} \RL{مطابق جدول ۴-۴،
  الگوریتم تنها با یک دور رمزنگاری، میانگین زمان اجرای ۲.۹۹ ثانیه برای
  رمزنگاری و ۲.۶۳ ثانیه برای رمزگشایی دارد. این عملکرد سریع در مقایسه با
  روش‌های چنددوری نشان‌دهنده بهینه بودن محاسباتی الگوریتم است و فرضیه ۴ را
  تأیید می‌کند}.

  \begin{enumerate}
  \def\labelenumii{\arabic{enumii}.}
  \item
    \protect\hypertarget{_Toc217957753}{}{}\RL{تحلیل و بحث}
  \end{enumerate}
\end{enumerate}

\RL{نتایج به‌دست‌آمده نشان می‌دهد که ترکیب ۹ نقشه آشوبی نمایی به‌صورت
دینامیک برای هر پیکسل، کارایی امنیتی بالایی ایجاد کرده است. به‌کارگیری
سیستم چن برای جایگشت، همبستگی مکانی تصویر را به حداقل می‌رساند و الگوریتم
را در برابر تحلیل‌های آماری و مکانی مقاوم می‌سازد. علاوه بر این، الگوریتم
به‌صورت کاملاً معکوس‌پذیر عمل کرده و هیچ اطلاعاتی از تصویر اصلی در خروجی
رمز شده باقی نمی‌گذارد. تحلیل هیستوگرام و آنتروپی نشان می‌دهد که توزیع
پیکسل‌ها به نحو قابل توجهی یکنواخت شده است و تصادفی بودن داده‌ها تضمین شده
است}.

\RL{نتایج} NPCR \RL{و} UACI \RL{نشان می‌دهند که الگوریتم توانایی بالایی
در ایجاد تغییرات گسترده و ناگهانی در تصویر دارد و مقاومت بالایی در برابر
حملات دیفرانسیلی دارد. همچنین، زمان اجرای کمتر از ۳ ثانیه برای تصاویر
۵۱۲×۵۱۲ بیانگر کارایی عملی و قابلیت استفاده در سیستم‌های با محدودیت زمانی
است}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{1}
\item
  \protect\hypertarget{_Toc217957754}{}{}\RL{مقایسه با سایر الگوریتم‌های
  رمزنگاری}
\end{enumerate}

\RL{برای تحلیل جامع‌تر، نتایج الگوریتم پیشنهادی با کارهای اخیر در ادبیات
موضوع مقایسه شده است}:

