\textbf{\RL{تحلیل فنی}:}

\begin{itemize}
\item
  \RL{الگوریتم پیشنهادی موفق شده با تنها یک دور، کارایی و امنیتی مشابه
  یا بهتر از روش‌های چنددوری ارائه دهد}.
\item
  \RL{استفاده از ۹ نقشه نمایی به‌صورت انتخاب دینامیک برای هر پیکسل،
  مقاومت در برابر تحلیل آماری و دیفرانسیلی را به شکل قابل توجهی افزایش
  داده است}.
\item
  \RL{زمان اجرای کمتر و ساده بودن پیاده‌سازی نسبت به روش‌های ارائه شده در}
  Hua \& Zhou(4) \RL{و} Khodadadi \& Zandvakili(7)\RL{، کاربرد عملی
  الگوریتم را در سیستم‌های بلادرنگ و کاربردی تضمین می‌کند}.

  \begin{enumerate}
  \def\labelenumi{\arabic{enumi}.}
  \item
    \protect\hypertarget{_Toc217957755}{}{}\RL{نتیجه‌گیری نهایی}
  \end{enumerate}
\end{itemize}

\RL{با توجه به نتایج عددی و بصری}:

\begin{itemize}
\item
  \RL{تمامی فرضیه‌های تحقیق تأیید شده‌اند (افزایش امنیت، کاهش همبستگی،
  آنتروپی بالا، کارایی محاسباتی)}.
\item
  \RL{الگوریتم پیشنهادی با تنها یک دور رمزنگاری، عملکردی برابر یا بهتر
  از الگوریتم‌های چنددوری منتشر شده ارائه می‌دهد}.
\item
  \RL{مقاومت بالایی در برابر حملات آماری، دیفرانسیلی و تحلیل‌های مکانی از
  خود نشان می‌دهد}.
\item
  \RL{ترکیب ۹ نقشه نمایی دینامیک و سیستم} Chen \RL{برای جایگشت، نوآوری
  کلیدی و مزیت رقابتی الگوریتم محسوب می‌شود}.

  \begin{enumerate}
