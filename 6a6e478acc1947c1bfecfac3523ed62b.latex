\begin{quote}
\RL{که در آن :}
\end{quote}

\begin{itemize}
\item
  \begin{quote}
  \(x(t)\)\RL{: حالت اول سیستم در زمان~}t
  \end{quote}
\item
  \begin{quote}
  \(Y(t)\)\RL{: حالت دوم سیستم در زمان~}t
  \end{quote}
\item
  \begin{quote}
  \(Z(t)\)\RL{: حالت سوم سیستم در زمان~}t
  \end{quote}
\end{itemize}

\begin{quote}
\textbf{\RL{و پارامترهای}}a\RL{،} b \RL{و} c \RL{یک مقدار ثابت هستند.}
\end{quote}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{2}
\item
  \textbf{\RL{رمزنگاری با سیستم‌های آشوبی نمایی}: \RL{}}\RL{برای هر}
  \RL{پیکسل، یک عدد بین ۱ تا ۹ تولید می‌شود که مشخص می‌کند کدام یک از ۹
  سیستم آشوبی نمایی} \RL{برای رمزنگاری آن پیکسل به کار رود}.
\item
  \textbf{\RL{انتشار مقادیر رنگی}: \RL{}}\RL{پس از جایگشت، مقادیر رنگی
  پیکسل‌ها با مقادیر تولید شده از سیستم آشوبی مربوطه ترکیب می‌شوند تا
  پیچیدگی و تصادفی بودن بیشتر شود}.
\item
  \textbf{\RL{ترکیب نهایی}: \RL{}}\RL{خروجی مرحله قبلی با یکی دیگر از
  سیستم‌های آشوبی ترکیب شده و فرآیند رمزنگاری} \RL{به‌صورت نهایی تکمیل
  می‌شود}.

  \begin{enumerate}
  \def\labelenumii{\arabic{enumii}.}
  \item
    \protect\hypertarget{_Toc217957739}{}{}\RL{پیاده‌سازی و تحلیل}
  \end{enumerate}
\end{enumerate}

\begin{itemize}
\item
  \textbf{\RL{پیاده‌سازی الگوریتم}:} \RL{برای شبیه‌سازی الگوریتم به کار
  گرفته شده و تحلیل‌های عددی در} Python \RL{با استفاده از کتابخانه‌های}
  \RL{علمی}\textbf{SciPy}\RL{،}\textbf{OpenCV}\RL{، و} \textbf{NumPy
  \RL{}}\RL{نجام می‌شود}.\RL{}
\item
  \textbf{\RL{ارزیابی امنیتی}:} \RL{معیارهایی مانند آنتروپی شانون، تحلیل
  همبستگی، حساسیت به شرایط اولیه و مقاومت در برابر حملات رمزنگاری مورد
  بررسی} \RL{قرار می‌گیرند}.\RL{}
\item
  \textbf{\RL{تحلیل زمان اجرا}:} \RL{زمان لازم برای رمزنگاری و رمزگشایی
  اندازه‌گیری شده و اثر اندازه تصویر بر زمان اجرا بررسی می‌شود}.
\item
  \textbf{\RL{تحلیل مقاومت}:} \RL{مقاومت الگوریتم در برابر حملات آماری،
  جستجوی فراگیر و تحلیل دیفرانسیلی بررسی می‌شود}.

  \begin{enumerate}
  \def\labelenumi{\arabic{enumi}.}
  \item
    \protect\hypertarget{_Toc217957740}{}{}\textbf{\RL{معماری نهایی و
    عملیاتی الگوریتم پیشنهادی}}
  \end{enumerate}
\end{itemize}

\RL{الگوریتم پیشنهادی پس از طی مراحل طراحی، بازآرایی و تصحیح، در شکل
نهایی خود به گونه‌ای تدوین شده که تمامی مؤلفه‌های نظری فصل‌های پیشین در آن
نهادینه شده‌اند. این معماری نه‌تنها مبتنی بر یک سیستم آشوبی، بلکه بر
\textbf{رویکرد چندآشوبیِ ترکیبی و نمایی} است که موجب جهش قابل توجه در
پیچیدگی محاسباتی-ساختاری می‌شود}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957741}{}{}\textbf{\RL{تحلیل ساختاری مراحل
  پیاده‌سازی}:}
\end{enumerate}

\hypertarget{ux62aux648ux644ux6ccux62f-ux645ux633ux6ccux631ux647ux627ux6cc-ux622ux634ux648ux628ux6cc-ux645ux628ux62aux646ux6cc-ux628ux631-ux633ux6ccux633ux62aux645-ux633ux647ux628ux639ux62fux6cc-chen}{%
\subsubsection{\texorpdfstring{\textbf{\RL{۱}. \RL{تولید مسیرهای آشوبی
مبتنی بر سیستم سه‌بعدی}
Chen}}{۱. تولید مسیرهای آشوبی مبتنی بر سیستم سه‌بعدی Chen}}\label{ux62aux648ux644ux6ccux62f-ux645ux633ux6ccux631ux647ux627ux6cc-ux622ux634ux648ux628ux6cc-ux645ux628ux62aux646ux6cc-ux628ux631-ux633ux6ccux633ux62aux645-ux633ux647ux628ux639ux62fux6cc-chen}}

\RL{سیستم آشوبی} Chen \RL{از جمله سیستم‌های سه‌بعدی ابرجاذبی است که حساسیت
بسیار بالایی به شرایط اولیه دارد. حل عددی این} \RL{سیستم با} solve\_ivp
\RL{نه‌تنها} \RL{پایداری محاسباتی را تضمین می‌کند بلکه به‌عنوان یک مولد با
کیفیت برای ایجاد دنباله‌های شبه‌تصادفی در مرحله جایگشت عمل می‌کند}.\\
\RL{وجود پویایی سه‌بعدی باعث تولید ساختارهای غیرخطی بسیار پیچیده می‌شود}.

\hypertarget{ux62aux648ux644ux6ccux62f-ux628ux631ux62fux627ux631-ux62cux627ux6ccux6afux634ux62a-ux627ux632-ux62fux646ux628ux627ux644ux647-ux622ux634ux648ux628ux6cc}{%
\subsubsection{\texorpdfstring{\textbf{\RL{۲}. \RL{تولید بردار جایگشت از
دنباله
آشوبی}}}{۲. تولید بردار جایگشت از دنباله آشوبی}}\label{ux62aux648ux644ux6ccux62f-ux628ux631ux62fux627ux631-ux62cux627ux6ccux6afux634ux62a-ux627ux632-ux62fux646ux628ux627ux644ux647-ux622ux634ux648ux628ux6cc}}

\RL{پس از نرمال‌سازی خروجی‌ها، تبدیل آن‌ها به شاخص‌های گسسته، بردارهای
جایگشت‌های یک‌به‌یک تولید می‌کند که موجب تخریب کامل ساختار هندسی تصویر
می‌شود}.

\RL{این بردارها به دلیل ماهیت آشوبی دنباله} Chen \RL{، فاقد هرگونه الگوی
خطی یا دوره‌ای هستند}.

\hypertarget{ux62aux639ux631ux6ccux641-ux6f9-ux633ux6ccux633ux62aux645-ux622ux634ux648ux628ux6cc-ux646ux645ux627ux6ccux6cc-ux62aux631ux6a9ux6ccux628ux6cc}{%
\subsubsection{\texorpdfstring{\textbf{\RL{۳}. \RL{تعریف ۹ سیستم آشوبی
نمایی
ترکیبی}}}{۳. تعریف ۹ سیستم آشوبی نمایی ترکیبی}}\label{ux62aux639ux631ux6ccux641-ux6f9-ux633ux6ccux633ux62aux645-ux622ux634ux648ux628ux6cc-ux646ux645ux627ux6ccux6cc-ux62aux631ux6a9ux6ccux628ux6cc}}

\RL{این ۹سیستم} \RL{با ساختاری که در آن از روابط نمایی-تکراری استفاده
می‌شود، توان محاسبات غیرخطی بسیار بالایی دارند و هرکدام به‌صورت مستقل
می‌توانند دنباله‌های بایت بسیار پیچیده‌ای را تولید کنند}.\\
\RL{وجود تنوع ۹گانه موجب کاهش شدید قابلیت پیش‌بینی می‌شود}.

\hypertarget{ux627ux646ux62aux62eux627ux628-ux62aux635ux627ux62fux641ux6cc-ux62aux627ux628ux639-ux646ux645ux627ux6ccux6cc-ux628ux631ux627ux6cc-ux647ux631-ux67eux6ccux6a9ux633ux644}{%
\subsubsection{\texorpdfstring{\textbf{\RL{۴}. \RL{انتخاب تصادفی تابع
نمایی برای هر
پیکسل}}}{۴. انتخاب تصادفی تابع نمایی برای هر پیکسل}}\label{ux627ux646ux62aux62eux627ux628-ux62aux635ux627ux62fux641ux6cc-ux62aux627ux628ux639-ux646ux645ux627ux6ccux6cc-ux628ux631ux627ux6cc-ux647ux631-ux67eux6ccux6a9ux633ux644}}

\RL{این مرحله، قلب معماری پیشنهادی است. برای هر پیکسل، سیستم رمزکننده
یکی از ۹ نقشه آشوبی را بر اساس انتخاب‌گر تصادفی مشخص می‌کند}. \RL{نتیجه
این کار، ایجاد یک \textbf{ساختار فوق‌العاده پیچیده در سطح انتشار} است که
مستقیماً روی آنتروپی اثر می‌گذارد}.

\hypertarget{ux62cux627ux6ccux6afux634ux62a-ux6a9ux627ux645ux644-ux62aux635ux648ux6ccux631}{%
\subsubsection{\texorpdfstring{\textbf{\RL{۵}. \RL{جایگشت کامل
تصویر}}}{۵. جایگشت کامل تصویر}}\label{ux62cux627ux6ccux6afux634ux62a-ux6a9ux627ux645ux644-ux62aux635ux648ux6ccux631}}

\RL{در این مرحله، ساختار مکانی تصویر کاملاً از بین می‌رود. الگوریتم با
استفاده از بردارهای جایگشت حاصل از سیستم} Chen\RL{، تصویر را به گونه‌ای
بازچینش می‌کند که هیچ رابطه هندسی میان پیکسل‌های مجاور باقی نمی‌ماند}.

\hypertarget{ux641ux627ux632-ux627ux646ux62aux634ux627ux631-ux645ux628ux62aux646ux6cc-ux628ux631-xor}{%
\subsubsection{\texorpdfstring{\textbf{\RL{۶}. \RL{فاز انتشار مبتنی بر}
XOR}}{۶. فاز انتشار مبتنی بر XOR}}\label{ux641ux627ux632-ux627ux646ux62aux634ux627ux631-ux645ux628ux62aux646ux6cc-ux628ux631-xor}}

\RL{دنباله‌های بایت‌های تولیدشده از نقشه‌های نمایی، به‌صورت مستقیم در
عملیات} XOR \RL{با پیکسل‌های جایگشت‌شده به‌کار گرفته می‌شوند}. \RL{این مرحله
عامل اصلی مقاومت در برابر حملات تفاضلی است}.

\hypertarget{ux631ux645ux632ux6afux634ux627ux6ccux6cc-ux645ux639ux6a9ux648ux633}{%
\subsubsection{\texorpdfstring{\textbf{\RL{۷}. \RL{رمزگشایی
معکوس}}}{۷. رمزگشایی معکوس}}\label{ux631ux645ux632ux6afux634ux627ux6ccux6cc-ux645ux639ux6a9ux648ux633}}

\RL{از آنجا که} XOR \RL{یک عملیات برگشت‌پذیر است و جایگشت نیز معکوس‌پذیر
طراحی شده، الگوریتم رمزگشایی می‌تواند تصویر اصلی را بدون هیچ‌گونه خطا
بازیابی کند}.

\RL{در نسخه} \RL{نهایی الگوریتم، مرحله انتشار به‌گونه‌ای بازطراحی شد که
دنباله آشوبی تولیدشده صرفاً به پارامترهای کلید، نگاشت انتخابی و اندیس
پیکسل وابسته باشد و از وابستگی مستقیم به مقدار پیکسل ورودی اجتناب}
\RL{شود. این اصلاح موجب شد عملیات انتشار کاملاً مستقل از داده‌ی تصویر بوده
و فرآیند رمزگشایی بدون بروز خطای عددی یا انتشار نویز انجام پذیرد. در
نتیجه، تصویر بازیابی‌شده پس از رمزگشایی به‌صورت صددرصد با تصویر اصلی منطبق
بوده و معکوس‌پذیری کامل الگوریتم تضمین می‌شود.}

\RL{\hfill\break
}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{3}
\item
  \protect\hypertarget{_Toc217957742}{}{}\RL{پیاده سازی الگوریتم
  پیشنهادی}
\end{enumerate}

\RL{\hfill\break
}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957743}{}{}\RL{مقدمه}
\end{enumerate}

\RL{در این فصل، نتایج حاصل از پیاده‌سازی عملی الگوریتم پیشنهادی رمزنگاری
تصویر ارائه و به‌صورت دقیق تحلیل می‌شود. به‌منظور ارزیابی جامع عملکرد روش
پیشنهادی، مجموعه‌ای از آزمایش‌های تجربی بر روی تصاویر رنگی استاندارد انجام
شده و نتایج به‌دست‌آمده از جنبه‌های مختلف امنیتی، آماری و محاسباتی مورد
بررسی قرار گرفته است. هدف اصلی این فصل، اعتبارسنجی عملی الگوریتم و
نشان‌دادن میزان کارایی آن در حفظ محرمانگی اطلاعات، معکوس‌پذیری کامل و
مقاومت در برابر حملات متداول رمزنگاری تصویر می‌باشد.}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{1}
\item
  \protect\hypertarget{_Toc217957744}{}{}\textbf{\RL{مجموعه داده آزمایشی
  و تنظیمات محیط اجرای الگوریتم}}
\end{enumerate}

\RL{برای تضمین مقایسه‌پذیری، تحلیل‌ها بر روی چهار تصویر شناخته‌شده مجموعه}
\textbf{USC-SIPI} \RL{ شامل} Tree\RL{،} Peppers\RL{،} Baboon \RL{و}
Airplane \RL{انجام شده است}. \RL{این تصاویر به علت تنوع ساختاری خود---از
لحاظ بافت، شدت تغییرات رنگی، جزئیات لبه‌ها و نوع توزیع پیکسل‌ها---معیاری
معتبر برای سنجش کیفیت الگوریتم‌های رمزنگاری تصویر به شمار می‌آیند}.

\RL{محیط اجرایی استاندارد و قابل بازتولید، شامل موارد زیر است}:

\begin{itemize}
\item
  \textbf{Python 3.11} \RL{برای پردازش داده}
\item
  \RL{کتابخانه‌های علمی}\textbf{SciPy}\RL{،}\textbf{OpenCV}\RL{، و}
  \textbf{NumPy}
\item
  \RL{پردازنده:} \textbf{Intel Core i7}
\item
  \RL{بدون} GPU
\end{itemize}

\RL{این موضوع امکان تحلیل عملکرد در شرایط واقعی و نه ایده‌آل را فراهم
می‌کند}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957745}{}{}\textbf{\RL{تحلیل بصری خروجی‌های
  رمزنگاری}}
\end{enumerate}

\RL{بر اساس شکل‌های 3--۱ تا 3--۱۲، خروجی‌های بصری سه نکته اساسی را نشان
می‌دهند:}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \RL{\textbf{تصاویر رمز شده ماهیت کاملاً نویزی دارند:} توزیع پیکسل‌های
  تصویر رمز شده به نحوی است که هیچ ویژگی بصری قابل تشخیص باقی نمی‌ماند.
  این یکی از مهم‌ترین شاخص‌های امنیتی محسوب می‌شود}.
\item
  \textbf{\RL{تصاویر بدون کوچک‌ترین خطا رمزگشایی می‌شوند:}} PSNR\RL{بین
  تصویر اصلی و رمزگشایی‌شده برابر ∞ بوده است؛ این یعنی الگوریتم در سطح
  عملیاتی هیچ تخریب داده ایجاد نمی‌کند}.
\item
  \RL{\textbf{تغییرات رنگی کاملاً از بین رفته‌اند}: ترکیب جایگشت و انتشار
  باعث شده که حتی کوچک‌ترین نشانه رنگی از تصویر اولیه نیز قابل بازیابی
  نباشد}.
\end{enumerate}

\RL{این نتایج بیانگر صحت عملکرد و پایداری الگوریتم هستند}.

