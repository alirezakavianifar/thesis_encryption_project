% ============================================================================
% CHAPTER 1 - SECTION 1: PROBLEM STATEMENT
% ============================================================================

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957694}{}{}\RL{بيان مسأله}
\end{enumerate}

\RL{در عصر دیجیتال، تبادل اطلاعات به‌ویژه در قالب تصاویر، به بخشی
جدایی‌ناپذیر از ارتباطات، تجارت، سیستم‌های نظارتی، و رسانه‌های اجتماعی
تبدیل شده است. در این میان، تصاویر دیجیتال به دلیل نقش کلیدی در انتقال
داده‌های بصری، به یکی از مهم‌ترین انواع اطلاعات چندرسانه‌ای بدل شده‌اند که
حجم بالایی از داده را در خود جای می‌دهند و کاربرد گسترده‌ای در شبکه‌های
ارتباطی، سامانه‌های ذخیره‌سازی و تحلیل داده دارند {[}1{]}.}

\RL{با گسترش دسترسی به فضای مجازی و تهدیدهای فزاینده در حوزه امنیت
سایبری، حفاظت از حریم خصوصی اطلاعات تصویری به یکی از دغدغه‌های اصلی
پژوهشگران و توسعه‌دهندگان امنیت اطلاعات تبدیل شده است. برخلاف داده‌های
متنی که رمزنگاری آن‌ها با الگوریتم‌های استانداردی نظیر} AES \RL{و} RSA
\RL{به‌خوبی قابل انجام است، تصاویر دیجیتال به دلیل ویژگی‌هایی همچون حجم
زیاد، ساختار دوبعدی، همبستگی آماری بالا میان پیکسل‌های مجاور، و حساسیت
بالا به تغییرات، به الگوریتم‌های رمزنگاری}\footnote{Encryption}
\RL{تخصصی‌تر و پیچیده‌تری نیاز دارند {[}2و3{]}.}

\RL{مهم‌ترین چالش‌ها در رمزنگاری تصاویر دیجیتال را می‌توان به شرح زیر
برشمرد:}

\RL{حفظ ویژگی‌های آماری تصویر پس از رمزنگاری؛}

\begin{itemize}
\item
  \RL{ایجاد مقاومت در برابر انواع حملات نظیر تحلیل آماری، حملات تمایزی و
  جستجوی فراگیر}\footnote{Brute Force} \RL{؛}
\item
  \RL{کاهش بار محاسباتی جهت کاربرد در سامانه‌های بلادرنگ؛}
\item
  \RL{پیشگیری از تخریب داده‌های تصویری طی فرآیند رمزنگاری و
  رمزگشایی}\footnote{Decryption}\RL{.}
\end{itemize}

\RL{در پاسخ به این چالش‌ها، بهره‌گیری از سیستم‌های آشوبی}\footnote{Chaotic
  Systems} \RL{به‌عنوان راهکاری مؤثر مورد توجه قرار گرفته است. سیستم‌های
آشوبی با رفتار غیرخطی، حساسیت شدید به شرایط اولیه، و توانایی تولید
دنباله‌های شبه‌تصادفی، امکان طراحی الگوریتم‌هایی با امنیت بالا و کلیدهای
غیرقابل پیش‌بینی را فراهم می‌آورند {[}4{]}. فرآیندهای جایگشت و پراکندگی
پیکسل‌ها با کمک این سیستم‌ها، ساختار آماری تصویر را به‌شدت تغییر داده و
مانع بازیابی تصویر اصلی بدون کلید می‌شوند.}

\RL{با این حال، یکی از نقاط ضعف رایج در الگوریتم‌های مبتنی بر سیستم‌های
آشوبی کلاسیک، بروز پدیده‌ای به‌نام «تخریب آشوب»}\footnote{Chaotic
  Degradation} \RL{است. این پدیده در شرایط خاص یا در اثر خطای عددی
می‌تواند باعث از دست رفتن ویژگی‌های آشوبی شود و در نهایت، امنیت سیستم را
کاهش دهد. این اشکال به‌ویژه در سیستم‌هایی نظیر نقشه} Logistic \RL{و} Tent
\RL{به‌صورت برجسته‌تری مشاهده شده است {[}5{]}.}

\RL{سیستم آشوبی به‌طور کلی، نوعی سیستم دینامیکی غیرخطی است که رفتار آن در
طول زمان به شدت به شرایط اولیه وابسته است و این وابستگی منجر به تولید
پاسخ‌هایی کاملاً متفاوت در صورت تغییرات بسیار جزئی در مقدارهای ورودی
می‌شود. به بیان ساده‌تر، سیستم آشوبی با وجود پیروی از معادلات مشخص،
خروجی‌ای شبه‌تصادفی و غیرقابل پیش‌بینی تولید می‌کند، به‌گونه‌ای که برای ناظر
بیرونی همانند نویز یا تصادف به نظر می‌رسد، اما در واقع دارای نظم در
بی‌نظمی است.}

\RL{ویژگی‌های اصلی سیستم‌های آشوبی شامل:}

\begin{itemize}
\item
  \RL{حساسیت شدید به شرایط اولیه}\footnote{Sensitive Dependence on
    Initial Conditions}
\item
  \RL{غیرخطی بودن روابط سیستم} \footnote{Nonlinearity}
\item
  \RL{رفتار شبه‌تصادفی}\footnote{Pseudo-randomness}
\item
  \RL{وابستگی به پارامترهای سیستمی}
\end{itemize}

\RL{این ویژگی‌ها باعث می‌شوند که سیستم‌های آشوبی گزینه‌ای بسیار مناسب برای
تولید کلیدهای رمزنگاری، الگوریتم‌های پراکندگی و اختفاء داده‌ها باشند.
به‌عنوان مثال، نگاشت‌های ساده‌ای مانند} Logistic\RL{،} Tent\RL{،}
Henon\RL{،} Chen \RL{و} Lorenz \RL{به‌طور گسترده در رمزنگاری تصویر به‌کار
رفته‌اند. سیستم لورنز}\footnote{Lorenz System} \RL{یکی از مشهورترین
مدل‌های آشوبی سه‌بعدی است که از معادلات دیفرانسیل غیرخطی تشکیل شده و در
ابتدا برای مدل‌سازی حرکت سیالات جوی طراحی شد، اما به‌دلیل توانایی بالا در
تولید مسیرهای آشوبی، امروزه در حوزه رمزنگاری و ارتباطات امن نیز مورد
استفاده قرار گرفته است {[}6{]}.}

\RL{از سوی دیگر، پژوهشگران برای افزایش مقاومت در برابر حملات تحلیل
همبستگی و جلوگیری از تخریب آشوب، سیستم‌هایی تحت عنوان نقشه‌های آشوب نمایی}
\footnote{Exponential Chaotic Maps} \RL{را توسعه داده‌اند. این سیستم‌ها،
با استفاده از نگاشت‌های ترکیبی و تغییرات پارامتری گسترده، دامنه آشوبی
پایدارتری نسبت به نگاشت‌های کلاسیک دارند و در نتیجه، در طراحی الگوریتم‌های
رمزنگاری مقاوم بسیار مؤثر واقع شده‌اند {[}4{]}. به‌عنوان نمونه، در
الگوریتمی که توسط خدادادی و زندوکیلی {[}7{]} ارائه شد، ترکیب دو سیستم}
Chen \RL{و} Logistic \RL{برای رمزنگاری تصویر پیشنهاد گردید؛ با این‌حال،
این روش نیز در شرایط خاص با کاهش پایداری و تخریب ویژگی آشوب مواجه بود .}

\RL{در پژوهش حاضر، با هدف ارتقاء سطح امنیت و کارایی الگوریتم‌های رمزنگاری
تصویر، روشی جدید معرفی می‌شود که از ترکیب نه سیستم آشوبی نمایی به‌همراه
الگوریتم جایگشت} Chen \RL{بهره می‌برد. سیستم‌های نمایی، مانند} LEL\RL{،}
SEL \RL{و سایر نگاشت‌های آشوب نمائی، به‌عنوان نسل جدید سیستم‌های آشوبی،
قادرند رفتارهای پیچیده‌تر و توزیع آماری یکنواخت‌تری نسبت به مدل‌های کلاسیک
ایجاد کنند {[}4{]}.}

\RL{در این الگوریتم، ابتدا پیکسل‌های تصویر با استفاده از دنباله‌های
تولیدشده توسط سیستم} Chen \RL{به‌صورت تصادفی جابه‌جا می‌شوند. سپس، رمزنگاری
هر پیکسل با انتخاب تصادفی یکی از ۹ سیستم نمایی صورت می‌گیرد. این رویکرد
چندلایه، علاوه بر ارتقاء پیچیدگی، موجب افزایش آنتروپی اطلاعاتی، کاهش
همبستگی پیکسل‌ها و افزایش مقاومت در برابر حملات تحلیل آماری می‌شود. از
طرفی، با بهره‌گیری از توزیع‌های آماری غیرخطی‌تر و پایدارتر، احتمال تخریب
ویژگی‌های آشوبی به‌طور مؤثری کاهش می‌یابد.}

\RL{در نهایت، هدف از این تحقیق، توسعه یک الگوریتم رمزنگاری مقاوم و
کارآمد است که با تکیه بر سیستم‌های آشوبی نوین، توازنی بهینه میان امنیت
بالا و سرعت اجرای مناسب برقرار کرده و پاسخگوی نیازهای کاربردی در
حوزه‌هایی همچون پزشکی، امنیت نظامی، شبکه‌های اجتماعی و ذخیره‌سازی ابری
باشد.}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957695}{}{}\RL{اهمیت و ضرورت تحقیق}
\end{enumerate}

\RL{با گسترش فناوری‌های دیجیتال و افزایش وابستگی جوامع به سامانه‌های
الکترونیکی، امنیت اطلاعات به یکی از دغدغه‌های اصلی در حوزه فناوری اطلاعات
تبدیل شده است. تصاویر دیجیتال، به‌ویژه تصاویر رنگی، به‌دلیل حجم بالای
اطلاعات و کاربرد گسترده در حوزه‌هایی مانند ارتبا.طات، شبکه‌های اجتماعی،
نظارت تصویری، پزشکی و نظامی، بیش از گذشته در معرض تهدیدات امنیتی نظیر
شنود، جعل و دستکاری قرار دارند {[}10{]}. اهمیت حفاظت از این داده‌های
بصری، ضرورت توسعه روش‌های نوین رمزنگاری را دوچندان کرده است}.

\RL{یکی از چالش‌های اساسی در رمزنگاری تصاویر رنگی، ساختار پیچیده و
چندبعدی آن‌هاست. تصاویر رنگی به‌صورت ترکیبی از سه کانال} RGB \RL{تعریف
می‌شوند که وابستگی بین کانال‌ها، کار رمزنگاری ایمن و بهینه را دشوار
می‌سازد. این وابستگی‌ها می‌توانند توسط مهاجمان برای تحلیل ساختاری تصویر
مورد سوءاستفاده قرار گیرند {[}3{]}. بنابراین، طراحی الگوریتم‌هایی که
بتوانند این وابستگی‌ها را کاهش داده و توزیع داده‌ها را تصادفی‌تر سازند،
امری حیاتی به نظر می‌رسد}.

\RL{مطالعات متعددی در حوزه رمزنگاری آشوبی انجام شده‌اند که نشان می‌دهند
سیستم‌های آشوبی به‌دلیل ویژگی‌هایی نظیر حساسیت بالا به شرایط اولیه، رفتار
غیرخطی و قابلیت تولید دنباله‌های شبه‌تصادفی پیچیده، ظرفیت بالایی در تولید
کلیدهای رمزنگاری غیرقابل پیش‌بینی دارند. با این حال، اغلب روش‌های موجود
تنها از یک سیستم آشوبی منفرد استفاده می‌کنند که در برابر حملاتی مانند
تحلیل همبستگی و جستجوی فراگیر آسیب‌پذیر هستند {[}12{]}. به‌منظور مقابله با
این آسیب‌پذیری‌ها، استفاده از ترکیب چند سیستم آشوبی نمایی به‌صورت تصادفی،
می‌تواند پیچیدگی رمزنگاری را افزایش داده و مقاومت آن را در برابر انواع
حملات ارتقا بخشد}.

\RL{بر اساس یافته‌های اخیر، سیستم‌های آشوبی نمایی نسبت به سیستم‌های آشوبی
کلاسیک مانند} Logistic \RL{و} Tent Map\RL{، توزیع احتمال پیچیده‌تری تولید
می‌کنند و پایداری بیشتری در برابر تغییرات پارامترها دارند. این ویژگی‌ها
آن‌ها را به گزینه‌ای مناسب برای پیاده‌سازی رمزنگاری‌های مقاوم تبدیل کرده است
{[}5{]}. از طرف دیگر، استفاده از سیستم‌هایی نظیر سیستم آشوبی} Chen\RL{،
با ویژگی‌هایی همچون سرعت پردازش بالا و سادگی پیاده‌سازی، می‌توانند به
افزایش کارایی الگوریتم‌های رمزنگاری کمک کنند}.

\RL{افزون بر این، بسیاری از کاربردهای حیاتی نظیر انتقال تصاویر پزشکی،
داده‌های مالی در بانکداری، یا اطلاعات طبقه‌بندی‌شده در صنایع نظامی، نیازمند
الگوریتم‌هایی هستند که هم امنیت بسیار بالایی داشته باشند و هم بتوانند در
زمان محدود پردازش انجام دهند؛ این مسأله، لزوم دستیابی به توازنی منطقی
میان امنیت و کارایی را پررنگ‌تر می‌کند {[}5{]}. در همین راستا، پژوهش حاضر
با ترکیب ۹ سیستم آشوبی نمایی و استفاده از سیستم آشوبی} Chen \RL{جهت
جایگشت، در پی توسعه مدلی نوین است که بتواند این توازن را به‌صورت مؤثر
محقق سازد}.

\RL{در نهایت، رمزنگاری آشوبی به‌عنوان یکی از حوزه‌های نوظهور در علوم
رمزنگاری، همچنان نیازمند تحقیقات عمیق‌تری برای بهره‌برداری کامل از
ظرفیت‌های خود است. مطالعات نظری و تجربی در این زمینه می‌توانند زمینه‌ساز
توسعه مدل‌های امن‌تر و بهینه‌تری برای محافظت از داده‌های حساس در عصر دیجیتال
باشند. پژوهش حاضر، با تمرکز بر طراحی و ارزیابی یک روش ترکیبی پیشرفته،
می‌کوشد گامی مؤثر در مسیر توسعه دانش رمزنگاری آشوبی بردارد.}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{1}
\item
  \protect\hypertarget{_Toc217957696}{}{}\RL{اهداف تحقيق}

  \begin{enumerate}
  \def\labelenumii{\arabic{enumii}.}
  \item
    \protect\hypertarget{_Toc217957697}{}{}\RL{هدف کلی}
  \end{enumerate}
\end{enumerate}

\RL{طراحی و توسعه‌ی الگوریتمی برای رمزنگاری تصاویر رنگی با بهره‌گیری از
ترکیب ۹ سیستم آشوبی نمایی، با هدف ارتقاء امنیت اطلاعات تصویری و بهبود
کارایی محاسباتی.}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{1}
\item
  \protect\hypertarget{_Toc217957698}{}{}\RL{اهداف جزئی}
\end{enumerate}

\begin{itemize}
\item
  \RL{بررسی عملکرد ۹ سیستم آشوبی نمایی در تولید دنباله‌های تصادفی پیچیده
  و غیرقابل پیش‌بینی.}
\item
  \RL{بهبود مقاومت الگوریتم رمزنگاری در برابر حملات آماری و جستجوی
  فراگیر از طریق ترکیب چندین سیستم آشوبی.}
\item
  \RL{افزایش پیچیدگی فرآیند رمزنگاری با استفاده از انتخاب تصادفی سیستم
  آشوبی برای رمزنگاری هر پیکسل.}
\item
  \RL{مقایسه امنیت و کارایی الگوریتم پیشنهادی با سایر روش‌های رمزنگاری
  مبتنی بر آشوب و ارزیابی میزان برتری آن.}

  \begin{enumerate}
  \def\labelenumi{\arabic{enumi}.}
  \item
    \protect\hypertarget{_Toc217957699}{}{}\RL{مفاهیم کلیدی تحقیق}
  \end{enumerate}
\end{itemize}

\textbf{\RL{رمزنگاری}}\footnote{Encryption}\textbf{\RL{:}}\\
\RL{فرایندی ریاضیاتی است که طی آن، داده‌های اصلی (تصویر، متن، صدا و ...)
به فرم غیرقابل فهم و ایمن تبدیل می‌شوند، به‌گونه‌ای که تنها افراد مجاز با
استفاده از کلید یا الگوریتم رمزگشایی می‌توانند به اطلاعات اصلی دسترسی
پیدا کنند. هدف اصلی رمزنگاری، حفظ محرمانگی، صحت و تمامیت اطلاعات در
برابر دسترسی یا دستکاری غیرمجاز است}.

\textbf{\RL{رمزنگاری تصویر}}\footnote{Image Encryption} \textbf{\RL{:}}

\RL{زیرشاخه‌ای از رمزنگاری است که تمرکز آن بر رمزنگاری داده‌های تصویری
به‌ویژه تصاویر دیجیتال رنگی یا خاکستری است. رمزنگاری تصویر باید با در نظر
گرفتن ویژگی‌های خاص تصویر نظیر حجم بالا، وابستگی بین پیکسل‌ها، ساختار دو
یا سه‌بعدی و حساسیت به تغییرات طراحی شود}.

\textbf{\RL{تصاویر رنگی}}\footnote{Color Images}\textbf{:}

\RL{تصاویری هستند که هر پیکسل آن‌ها از ترکیب سه کانال اصلی رنگی قرمز}
(R)\RL{، سبز} (G) \RL{و آبی} (B) \RL{تشکیل شده است. این کانال‌ها مقادیر
عددی خاصی دارند (معمولاً در بازه ۰ تا ۲۵۵) که در مجموع رنگ نهایی پیکسل را
مشخص می‌کنند. رمزنگاری این نوع تصاویر نیازمند رویکردهای پیچیده‌تری نسبت به
تصاویر خاکستری است، زیرا اطلاعات بین کانال‌ها وابسته و همبسته هستند}.

\textbf{\RL{سیستم آشوبی}}\footnote{Chaotic System}\textbf{\RL{:}}

\RL{سیستم‌های دینامیکی غیرخطی هستند که رفتار آن‌ها در طول زمان به شدت به
شرایط اولیه وابسته است. این سیستم‌ها با وجود آن‌که معادلات دقیق و قطعی
دارند، نتایجی شبه‌تصادفی، غیرقابل پیش‌بینی و پیچیده تولید می‌کنند.
ویژگی‌هایی مانند حساسیت به مقدار اولیه، غیرخطی‌بودن و قابلیت تولید
دنباله‌های پیچیده، آن‌ها را برای تولید کلیدها و ایجاد اختفاء در رمزنگاری
بسیار مناسب ساخته است}.

\textbf{\RL{نگاشت}} \RL{\textbf{آشوب نمایی}}\footnote{Exponential
  Chaotic Map} \textbf{:}

\RL{دسته‌ای پیشرفته از سیستم‌های آشوبی هستند که با ترکیب نگاشت‌های ریاضی
ساده مانند} Logistic\RL{،} Sine \RL{و} Tent \RL{و افزودن مولفه‌های نمایی،
رفتارهای غیرخطی و پویاتری را ایجاد می‌کنند. این نگاشت‌ها دارای دامنه آشوب
وسیع‌تر، پایداری بیشتر نسبت به خطا و قابلیت تولید دنباله‌های رمزنگاری
غیرقابل پیش‌بینی هستند. نمونه‌هایی از این سیستم‌ها عبارتند از} LEL\RL{،}
SEL\RL{،} LET \RL{و} ...

\textbf{\RL{جایگشت}}\footnote{Permutation} \textbf{:}\\
\RL{یکی از مراحل اصلی در رمزنگاری تصویر است که طی آن موقعیت پیکسل‌های
تصویر به‌صورت غیرقابل پیش‌بینی تغییر داده می‌شود، بدون آن‌که مقادیر رنگی
آن‌ها تغییر یابد. هدف این مرحله، از بین بردن ساختار و همبستگی مکانی بین
پیکسل‌ها است تا تحلیل آماری برای مهاجم دشوار شود}.

\textbf{\RL{انتشار}}\footnote{Diffusion}\textbf{:}\\
\RL{مرحله‌ای از رمزنگاری که در آن مقادیر رنگی پیکسل‌ها تغییر داده می‌شوند.
به عبارتی، اطلاعات تصویری با مقادیر تصادفی ترکیب می‌شود تا رابطه‌ای میان
داده‌های ورودی و خروجی باقی نماند. این مرحله باعث افزایش مقاومت در برابر
تحلیل تفاضلی می‌شود}.

\textbf{\RL{آنتروپی شانون}} \footnote{Shannon Entropy}\textbf{:}

\RL{مقیاسی از میزان تصادفی‌بودن یا بی‌نظمی در توزیع داده‌هاست. در رمزنگاری
تصویر، هر چه مقدار آنتروپی به مقدار ایده‌آل (برای تصاویر ۸ بیتی، مقدار ۸)
نزدیک‌تر باشد، نشان‌دهنده آن است که الگوریتم رمزنگاری به‌خوبی توانسته تصویر
را غیرقابل تحلیل کند}.

\textbf{NPCR \RL{و} UACI\RL{:}}

\RL{دو معیار مهم برای ارزیابی حساسیت الگوریتم رمزنگاری نسبت به تغییرات
جزئی در کلید یا تصویر اولیه هستند}.

\begin{itemize}
\item
  \textbf{NPCR}\footnote{Number of Pixel Change Rate} \RL{درصد تغییرات
  پیکسل‌ها بین دو تصویر رمزنگاری‌شده با کلیدهای بسیار نزدیک}.
\item
  \textbf{UACI} \footnote{Unified Average Changing Intensity}
  \RL{میانگین شدت تغییرات بین پیکسل‌های دو تصویر رمزنگاری‌شده}.

  \begin{enumerate}
  \def\labelenumi{\arabic{enumi}.}
  \item
    \protect\hypertarget{_Toc217957700}{}{}\RL{سهم علمی پژوهش}
  \end{enumerate}
\end{itemize}

\RL{در این پایان‌نامه، یک چارچوب نوین برای رمزنگاری تصاویر رنگی مبتنی بر
سیستم‌های آشوبی نمایی ارائه شده است که با هدف افزایش امنیت، پیچیدگی
دینامیکی و معکوس‌پذیری کامل طراحی گردیده است. مهم‌ترین سهم‌های علمی این
پژوهش به شرح زیر می‌باشند}:

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \RL{ارائه یک الگوریتم رمزنگاری تصویر مبتنی بر مدل آشوبی
  نمایی}\footnote{Exponential Chaotic Model} \RL{که با ترکیب غیرخطی
  نگاشت‌های پایه، دنباله‌های آشوبی با رفتار پیچیده‌تر و حساسیت بالاتر نسبت
  به شرایط اولیه تولید می‌کند}.
\item
  \RL{استفاده هم‌زمان از چند سیستم آشوبی نمایی (۹ نگاشت متفاوت) و انتخاب
  پویاى آن‌ها در سطح پیکسل، که منجر به افزایش فضای کلید، کاهش الگوپذیری و
  ارتقای مقاومت الگوریتم در برابر حملات آماری و دیفرانسیلی می‌شود}.
\item
  \RL{طراحی یک سازوکار انتشار اصلاح‌شده و کاملاً معکوس‌پذیر که در آن دنباله
  آشوبی صرفاً به کلید و اندیس پیکسل وابسته بوده و از وابستگی مستقیم به
  مقدار پیکسل جلوگیری شده است. این ویژگی تضمین می‌کند که تصویر
  رمزگشایی‌شده به‌صورت صددرصد با تصویر اصلی منطبق باشد}.
\item
  \RL{بهره‌گیری از سیستم آشوبی پیوسته} Chen \RL{برای تولید جریان کلید، که
  در مقایسه با نگاشت‌های گسسته، کیفیت آشوب، حساسیت به شرایط اولیه و امنیت
  کلید را به‌طور قابل‌توجهی افزایش می‌دهد}.
\item
  \RL{انجام مجموعه‌ای جامع از تحلیل‌های امنیتی شامل آنتروپی، همبستگی
  پیکسل‌های مجاور،} NPCR\RL{،} UACI \RL{و تحلیل هیستوگرام، که نشان‌دهنده
  عملکرد مناسب الگوریتم پیشنهادی در مقایسه با روش‌های موجود می‌باشد}.
\item
  \RL{پیاده‌سازی کامل الگوریتم و ارزیابی تجربی آن بر روی تصاویر رنگی
  استاندارد با ابعاد مختلف، که کارایی عملی و قابلیت کاربرد الگوریتم در
  سناریوهای واقعی را تأیید می‌کند.}

  \begin{enumerate}
  \def\labelenumii{\arabic{enumii}.}
  \item
    \protect\hypertarget{_Toc217957701}{}{}\RL{ساختار پایان‌نامه}
  \end{enumerate}
\end{enumerate}

\RL{ساختار این پایان‌نامه به‌صورت زیر سازمان‌دهی شده است}:

\RL{در فصل دوم، مفاهیم پایه و پیش‌نیازهای نظری مرتبط با رمزنگاری تصاویر،
سیستم‌های آشوبی، ویژگی‌های نگاشت‌های آشوبی و معیارهای ارزیابی امنیت مرور
می‌شود. همچنین برخی از مهم‌ترین پژوهش‌های انجام‌شده در این حوزه مورد بررسی
قرار می‌گیرند}.

\RL{فصل سوم به معرفی الگوریتم پیشنهادی اختصاص دارد. در این فصل، معماری
کلی روش ارائه‌شده، فرآیند تولید کلید، مرحله جایگشت و مرحله انتشار به‌طور
دقیق تشریح شده و روند رمزنگاری و رمزگشایی به‌صورت گام‌به‌گام توضیح داده
می‌شود}.

\RL{در فصل چهارم، پیاده‌سازی عملی الگوریتم و نتایج آزمایش‌های تجربی ارائه
می‌گردد. در این فصل، عملکرد الگوریتم پیشنهادی از نظر معیارهای امنیتی و
آماری تحلیل شده و نتایج به‌صورت جداول و نمودارهای تحلیلی گزارش می‌شوند}.

\RL{در فصل پنجم، نتایج به‌دست‌آمده مورد بحث و بررسی قرار گرفته و عملکرد
روش پیشنهادی با برخی از روش‌های مطرح در ادبیات پژوهش مقایسه می‌شود. در
پایان این فصل، جمع‌بندی نهایی پژوهش ارائه شده و پیشنهادهایی برای تحقیقات
آینده مطرح می‌گردد.}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{1}
\item
  \protect\hypertarget{_Toc217957702}{}{}\RL{مفاهیم پایه و پیشینه تحقیق}
\end{enumerate}

\RL{\hfill\break
}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957703}{}{}\RL{مقدمه}
\end{enumerate}

\RL{از زمان انتشار مشاهدات ادوارد لورنز در زمینه‌ی رفتارهای آشوبناک،
مفهوم «آشوب» به یکی از موضوعات مورد توجه در جامعه‌ی علمی تبدیل شد. نظریه‌ی
آشوب شاخه‌ای از ریاضیات است که به تحلیل سیستم‌هایی می‌پردازد که رفتار آن‌ها
به تغییرات کوچک در شرایط اولیه بسیار حساس است. به بیان دیگر، در این‌گونه
سامانه‌ها، تغییرات ظاهراً ناچیز می‌تواند منجر به تفاوت‌های چشمگیر در خروجی
شود}.

\RL{پیش از ظهور این نظریه، بسیاری از پدیده‌های تصادفی یا غیرقابل‌پیش‌بینی،
فاقد توجیه علمی دقیق تلقی می‌شدند، اما نظریه‌ی آشوب توانست با اتکا بر اصول
ریاضی، فیزیک و فلسفه، مبانی تبیینی منسجمی برای این پدیده‌ها فراهم آورد.
قانون علت و معلول همچنان در این نظریه برقرار است، اما تعداد عوامل مؤثر
بر نتایج به‌طور چشمگیری افزایش می‌یابد. در واقع، نظریه‌ی آشوب ابزاری فراهم
می‌کند تا بتوان پدیده‌های پیچیده‌ی طبیعی و واقعی را بهتر درک و تحلیل کرد}.

\RL{نکته‌ی مهم آن است که نظریه‌ی آشوب صرفاً به‌منزله‌ی روشی برای ساده‌سازی
پدیده‌های فیزیکی در نظر گرفته نمی‌شود، بلکه مدل‌های ریاضی ناشی از آن،
به‌عنوان منبعی از اطلاعات جدید و غیرخطی محسوب می‌شوند. این مدل‌ها می‌توانند
نه تنها رفتار سامانه‌های واقعی را پیش‌بینی کنند، بلکه در حوزه‌های دیگر از
جمله علوم مهندسی، فیزیک، و رمزنگاری اطلاعات نیز به کار گرفته شوند}.

\RL{در سال‌های اخیر، توجه ویژه‌ای به کاربرد نظریه‌ی آشوب در علم ارتباطات و
امنیت اطلاعات شده است. ویژگی‌هایی چون حساسیت بالا به شرایط اولیه،
غیرقابل‌پیش‌بینی بودن و رفتار شبه‌تصادفی، سبب شده تا سیستم‌های آشوبی به‌عنوان
بستری مناسب برای طراحی الگوریتم‌های رمزنگاری مطرح شوند}.

\RL{در واقع، میان ویژگی‌های ذاتی سامانه‌های آشوبناک و خواص مطلوب در یک
سامانه‌ی رمزنگاری امن (نظیر پخش و درهم‌سازی قوی، وابستگی شدید به کلید، و
مقاومت در برابر حملات آماری) شباهت‌های قابل‌توجهی وجود دارد. با وجود این
ارتباط نزدیک، طراحی الگوریتم‌های رمزنگاری مؤثر بر پایه‌ی سیستم‌های آشوبی
نیازمند دقت و دانش عمیق ریاضی است؛ چرا که هرگونه خطا در پیاده‌سازی یا
انتخاب پارامترها می‌تواند امنیت سامانه را به‌شدت کاهش دهد}.

\RL{بر این اساس، در این فصل به معرفی مبانی نظری مرتبط با موضوع پژوهش
پرداخته می‌شود. ابتدا مفاهیم بنیادین رمزنگاری و انواع روش‌های آن مرور
می‌گردد، سپس ویژگی‌های اصلی تصاویر دیجیتال، نظریه‌ی آشوب، انواع توابع آشوب
و ارتباط میان آشوب و رمزنگاری مورد بررسی قرار می‌گیرد. در ادامه نیز به
بررسی پژوهش‌های پیشین در زمینه‌ی استفاده از سیستم‌های آشوبی در رمزنگاری
تصاویر رنگی پرداخته خواهد شد.}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{1}
\item
  \protect\hypertarget{_Toc217957704}{}{}\RL{رمزنگاری}
\end{enumerate}

\RL{رمزنگاری یا رمزگذاری} \RL{فرآیندی است که طی آن اطلاعات به‌کمک یک
الگوریتم خاص به صورتی غیرقابل‌فهم برای افراد غیرمجاز تبدیل و ذخیره می‌شود
تا از دسترسی یا سوء‌استفاده‌ی احتمالی از آن جلوگیری گردد. در هر سیستم
رمزنگاری، کلیدی وجود دارد که تنها در اختیار رمزگذار (فرستنده یا گیرنده‌ی
مجاز) قرار دارد. این کلید برای معکوس‌سازی عملیات رمزنگاری و بازگردانی
داده‌ها به حالت اولیه به‌کار می‌رود که این عمل را رمزگشایی} \RL{می‌نامند}.

\RL{رمزنگاری از دیرباز در میان دولت‌ها، نیروهای نظامی و نهادهای امنیتی
برای برقراری ارتباطات محرمانه و ایمن مورد استفاده قرار می‌گرفت. با گذشت
زمان و گسترش فناوری‌های دیجیتال، کاربرد رمزنگاری به حوزه‌های غیرنظامی نیز
گسترش یافته است؛ به‌گونه‌ای که امروزه در بسیاری از سامانه‌های کامپیوتری و
ارتباطی، به‌منظور حفظ امنیت داده‌ها، از روش‌های رمزگذاری استفاده می‌شود. این
فناوری می‌تواند برای محافظت از داده‌های ذخیره‌شده در حافظه‌های مختلف مانند
دیسک سخت، فلش مموری و یا در جریان انتقال اطلاعات از طریق شبکه‌هایی نظیر
اینترنت، تلفن همراه، ارتباطات بی‌سیم و بلوتوث به‌کار گرفته شود} \RL{(14).}

\RL{از دیدگاه واژه‌شناسی، واژه‌ی رمزنگاری} \footnote{Cryptography}\RL{از
دو واژه‌ی یونانی} krypto \RL{به معنی «پنهان» و} grapho \RL{به معنی
«نوشتن» تشکیل شده است. در مفهوم علمی، رمزنگاری به معنای تبدیل متن
آشکار}\footnote{Plain Text} \RL{به متن} \RL{رمز} \footnote{Cipher Text}\RL{و}
\RL{برعکس است. عملیات تبدیل متن آشکار به متن رمز را رمزگذاری} \RL{و
تبدیل متن رمز به متن آشکار را رمزگشایی} \RL{می‌گویند}.

\RL{در دوران باستان، به‌ویژه در مصر، از روش‌های ابتدایی جایگزینی
حروف}\footnote{Substitution} \RL{برای رمزگذاری پیام‌ها استفاده می‌شد. در
این روش هر حرف با حرف یا نمادی دیگر جایگزین می‌شد که تنها افراد خاص از
معنا و قاعده‌ی آن اطلاع داشتند. با وجود کاربرد ساده، این روش با چالش‌هایی
مواجه بود؛ زیرا لازم بود برای هر جفت فرستنده و گیرنده، یک مجموعه کد
منحصربه‌فرد تعریف شود، که این امر در عمل باعث دشواری استفاده‌ی گسترده از
این سیستم می‌گردید} \RL{(15).}

\RL{به همین دلیل، در ادامه‌ی توسعه‌ی علم رمزنگاری، مفهوم} \RL{کلید} (Key)
\RL{مطرح} \RL{شد. در این روش، تبدیل متن آشکار به متن رمز براساس پارامتری
مستقل از خود متن و مبتنی بر کلید انجام می‌گیرد. به این ترتیب، فرستنده و
گیرنده تنها لازم است از الگوریتم رمزنگاری و کلید مشترک اطلاع داشته باشند
و نیازی به تبادل دستی کدهای اختصاصی وجود ندارد}.

\RL{در دوران انقلاب صنعتی و هم‌زمان با رشد فناوری‌های مخابراتی، علم
رمزنگاری نیز دچار تحول شد. با گسترش تلگراف، رادیو و وسایل ارتباطی جدید،
لازم بود پیام‌ها به‌جای حروف انسانی، به کدهای دودویی (۰ و ۱) تبدیل شوند.
بدین ترتیب، رمزنگاری از حوزه‌ی زبان طبیعی وارد دنیای دیجیتال گردید و
مفاهیم جدیدی مانند بیت، کلید مخفی و الگوریتم‌های ریاضی رمزگذاری مطرح
شدند. در این مرحله، رمزنگاری دیگر صرفاً ابزاری برای پنهان‌سازی متن نبود،
بلکه به شاخه‌ای از ریاضیات و علوم رایانه تبدیل شد که امنیت داده‌ها را بر
اساس مدل‌های ریاضی تضمین} \RL{می‌کرد} \RL{(16).}

\RL{به طور کلی، علم رمزنگاری امروزه نقش بنیادینی در امنیت ارتباطات
دیجیتال، بانکداری الکترونیک، تجارت اینترنتی، شبکه‌های اجتماعی و حتی
ذخیره‌سازی ابری ایفا می‌کند و پایه‌ی بسیاری از سامانه‌های امنیتی مدرن را
تشکیل می‌دهد.}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957705}{}{}\RL{تعریف رمزنگاری}
\end{enumerate}

\RL{رمزنگاری فرآیندی است که طی آن اطلاعات به‌گونه‌ای دچار تغییر و بازآرایی
می‌شوند که برای افراد غیرمجاز غیرقابل فهم باشد. فناوری رمزنگاری دسترسی به
پیام‌ها و اطلاعات ارسالی را برای افراد غیرمجاز محدود کرده و امکان مشاهده،
مطالعه و تفسیر آن‌ها را سلب می‌کند. این فناوری به‌ویژه برای حفاظت از داده‌ها
در شبکه‌های عمومی مانند} \RL{اینترنت کاربرد دارد} \RL{(17).}

\RL{هدف اصلی رمزنگاری، طراحی طرح‌ها و پروتکل‌هایی است که حتی در حضور دشمن
نیز امکان انجام فعالیت‌های خاص را فراهم سازد. یکی از اهداف اساسی این
حوزه، ایجاد امکان ارتباط امن بر روی کانال‌های ناامن است؛ به‌طوری که حریم
خصوصی و اصالت داده‌ها به‌طور کامل حفظ شود. برای رسیدن به این هدف،
الگوریتم‌های ریاضی پیشرفته‌ای برای رمزگذاری پیام‌ها و ضمائم مربوطه به‌کار
گرفته می‌شوند} \RL{(18).}

\RL{در بیشتر روش‌های رمزنگاری، از فرآیندهای برگشت‌پذیر}\footnote{Reversible}
\RL{استفاده می‌شود تا دریافت‌کننده در مقصد بتواند متن رمز را به متن آشکار}
\RL{بازگرداند. قوانین و تکنیک‌هایی که برای رمزنگاری به‌کار می‌روند، به
عنوان الگوریتم‌های رمزنگاری شناخته می‌شوند و میزان سادگی یا پیچیدگی فرایند
رمزگذاری را تعیین می‌کنند. بسیاری از الگوریتم‌های رمزنگاری، از کلید}
\RL{به‌عنوان پارامتری محرمانه برای رمزگذاری و رمزگشایی استفاده می‌کنند.
کلید، در واقع یک کلمه عبور است که تنها فرستنده و گیرنده پیام از آن اطلاع
دارند. الگوریتم رمزنگاری با استفاده از قواعد ریاضی، کلید (که معمولاً
رشته‌ای طولانی از اعداد است) را بر اطلاعات اعمال می‌کند} \RL{(19).}

\RL{تکنیک‌های رمزنگاری پیچیده، برخلاف روش‌های ساده‌ی جایگزینی یا جابجایی،
از یک کلید محرمانه برای کنترل توالی‌های طولانی و پیچیده از جایگزینی‌ها و
جابجایی‌ها بهره می‌برند. کلید و الگوریتم رمزنگاری با همکاری یکدیگر، متن
اولیه را به متن رمز تبدیل می‌کنند. در اغلب سیستم‌ها، الگوریتم رمزنگاری
ثابت و شناخته‌شده است و کلید است که خروجی یکتا و امنی تولید می‌کند}
\RL{(20).}

\RL{در گذشته، امنیت سیستم‌های رمزنگاری به میزان محرمانه بودن الگوریتم
وابسته بود. با پیشرفت علم رمزنگاری، الگوریتم‌ها توانستند از این وابستگی
عبور کنند و بر محدودیت طول کلید و محرمانگی آن غالب شوند. امروزه، قابل
اعتمادترین الگوریتم‌های رمزنگاری باید پس از چندین مرحله تحقیق و بررسی
دقیق و عمومی، توانایی خود را نشان دهند تا اعتماد سازمان‌ها و کاربران را
جلب کنند. ایجاد چنین الگوریتم‌هایی، فرآیندی پیچیده و نیازمند دقت بسیار
بالا است (21).}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{1}
\item
  \protect\hypertarget{_Toc217957706}{}{}\RL{شیوه‌های پایه رمزنگاری}
\end{enumerate}

\RL{در رمزنگاری کلاسیک، دو شیوه‌ی پایه وجود دارد که اساس بسیاری از
الگوریتم‌های مدرن را تشکیل می‌دهند: رمزنگاری جابجایی}\footnote{Transposition}
\RL{و رمزنگاری جایگزینی}\footnote{Substitution} \RL{(22).}

\RL{الف) رمزنگاری جابجایی}

\RL{رمزنگاری جابجایی روشی است که در آن متن اصلی بدون تغییر محتوا، به‌صورت
ترتیبی جابجا می‌شود تا متن رمز تولید شود. عملیات رمزگشایی نیز با اجرای
برعکس همان جابجایی امکان‌پذیر است. از دیدگاه ریاضی، یک تابع یک‌به‌یک بر روی
موقعیت‌های متن اعمال می‌شود و معکوس آن برای بازگرداندن متن اصلی استفاده
می‌گردد}.

\RL{ویژگی اصلی رمزنگاری جابجایی این است که محتوای متن تغییر نمی‌کند، بلکه
ترتیب آن دگرگون می‌شود. این خاصیت باعث می‌شود که تغییر حتی یک بیت از کلید
یا متن اصلی، خروجی رمز متفاوتی ایجاد کند؛ به عبارتی، سیستم رمز به
تغییرات کوچک در متن یا کلید بسیار حساس است. نمونه‌ای ساده از این شیوه،
استفاده از جایگشت} \RL{است که ترکیب نمادهای متن را تغییر می‌دهد. در
رمزنگاری تصویر، فرآیند جابجایی معادل جابجایی موقعیت پیکسل‌ها در تصویر
است، بدون اینکه مقدار آن‌ها تغییر یابد} \RL{(23).}

\RL{ب) رمزنگاری جایگزینی}

\RL{رمزنگاری جایگزینی، روشی است که در آن هر واحد از متن اصلی با یک نماد
دیگر طبق یک سیستم مشخص جایگزین می‌شود تا متن رمز حاصل گردد. هدف اصلی این
شیوه، جلوگیری از مشاهده‌ی الگوهای تکراری در متن رمز است. عملیات رمزگشایی
با استفاده از عکس عمل جایگذاری امکان‌پذیر می‌شود}.

\RL{ساده‌ترین نوع جایگزینی، جانشینی یک نماد با نماد دیگر است. در رمزنگاری
تصویر، این فرآیند برای تغییر مقادیر پیکسل‌ها به کار می‌رود. مقایسه‌ی
رمزنگاری جایگزینی و جابجایی نشان می‌دهد که در جایگزینی، مکان نمادها ثابت
است و تنها مقدار آن‌ها تغییر می‌کند، در حالی که در جابجایی، نمادها
دست‌نخورده باقی می‌مانند اما موقعیت آن‌ها تغییر می‌کند (22، 24).}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{2}
\item
  \protect\hypertarget{_Toc217957707}{}{}\RL{انواع روش‌های رمزنگاری بر
  اساس نوع کلید}
\end{enumerate}

\RL{بر اساس نوع کلید، الگوریتم‌های رمزنگاری به دو دسته تقسیم می‌شوند:
رمزنگاری متقارن}\footnote{Symmetric Key Cryptography} \RL{و رمزنگاری
نامتقارن}\footnote{Asymmetric Key Cryptography} \RL{(25).}

\RL{الف) رمزنگاری متقارن}

\RL{رمزنگاری متقارن که گاهی به آن رمز مشترک نیز گفته می‌شود، دسته‌ای از
الگوریتم‌هاست که برای رمزگذاری و رمزگشایی پیام‌ها از کلیدهای یکسان یا
مشابه استفاده می‌کنند. در عمل، این کلید نشان‌دهنده یک راز مشترک میان دو یا
چند طرف است که برای حفظ اطلاعات خصوصی به کار می‌رود. امنیت این روش وابسته
به طول کلید و محرمانه بودن آن است. یکی از مزایای رمزنگاری متقارن، سرعت
بالای پردازش و اجرای الگوریتم‌ها است که آن را به گزینه‌ای مناسب برای
انتقال اطلاعات در اینترنت یا ذخیره‌سازی داده‌های حساس در بانک‌های اطلاعاتی
تبدیل می‌کند} \RL{(26)}

\RL{در الگوریتم‌های متقارن، علاوه بر ارسال پیام رمز شده، کلید مورد
استفاده نیز باید به مقصد منتقل شود یا در آنجا موجود باشد. این امر
نیازمند وجود یک کانال امن برای توزیع کلید است. در صورت فقدان چنین کانالی
یا عدم امکان تأیید هویت گیرنده کلید، امنیت سیستم به خطر می‌افتد. همچنین،
تبادل مکرر کلید می‌تواند بار اضافی بر سیستم تحمیل کند. به همین دلیل،
روش‌های متقارن بیشترین بازده را در محیط‌هایی دارند که کانال امن برای توزیع
و نگهداری کلیدها وجود دارد یا فرستنده و گیرنده قبلاً هویت یکدیگر را تأیید
کرده‌اند}.

\RL{رمزنگاری متقارن می‌تواند به دو نوع تقسیم شود}:

\RL{رمزهای} \RL{جریانی} (Stream Ciphers): \RL{هر بیت} \RL{یا رقم پیام به
صورت مستقل رمزگذاری می‌شود}.

\RL{رمزهای بلوکی} (Block Ciphers): \RL{تعدادی بیت به‌صورت یک واحد
رمزگذاری می‌شوند}.

\RL{استاندارد} AES (Advanced Encryption Standard) \RL{که توسط} NIST
\RL{در دسامبر 2001 تایید شد، نمونه‌ای از الگوریتم بلوکی با بلوک‌های 128
بیتی است. رمزهای جریانی سرعت بیشتری نسبت به رمزهای بلوکی دارند زیرا
پیچیدگی الگوریتمی کمتری دارند. از نمونه‌های مشهور الگوریتم‌های متقارن
می‌توان به سیستم‌های کلاسیک مانند} Vigenere\RL{،} Substitution\RL{،}
DES\RL{،} AES \RL{و} IDES \RL{و همچنین رمزهای جریانی مبتنی بر} LFSR
\RL{اشاره کرد} \RL{(25، 27)}

% ============================================================================
% CHAPTER 2 - ASYMMETRIC ENCRYPTION
% ============================================================================

\RL{ب) رمزنگاری نامتقارن}

\RL{رمزنگاری نامتقارن یا رمزنگاری کلید عمومی نوعی از رمزنگاری است که در
آن کلید رمزگذاری با کلید رمزگشایی متفاوت است؛ برخلاف رمزنگاری متقارن که
هر دو عملیات با یک کلید انجام می‌شود. در این روش، هر کاربر یک جفت کلید در
اختیار دارد}:

\RL{کلید عمومی: برای رمزگذاری پیام‌ها و تأیید صحت امضای دیجیتال}.

\RL{کلید خصوصی: برای رمزگشایی پیام‌ها و امضای دیجیتال داده‌ها}.

\RL{کلید خصوصی مخفی نگه داشته می‌شود، در حالی که کلید عمومی می‌تواند به
طور گسترده منتشر شود. پیام‌های رمز شده توسط کلید عمومی تنها توسط دارنده‌ی
کلید خصوصی متناظر قابل خواندن هستند. کلید خصوصی نمی‌تواند از کلید عمومی
محاسبه شود، اما بین این دو کلید یک رابطه ریاضی وجود دارد که امکان
رمزگذاری و رمزگشایی امن را فراهم می‌کند}.

\RL{در روش نامتقارن، کلیدها دارای ساختار مشخصی با هشت فیلد اطلاعاتی
هستند که دو فیلد به کلید عمومی و شش فیلد به کلید خصوصی اختصاص دارد (28).
این ساختار پیچیده سبب می‌شود که پیام‌ها بدون دسترسی به کلید خصوصی، غیرقابل
خواندن باشند و امنیت انتقال داده تضمین گردد.}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{3}
\item
  \protect\hypertarget{_Toc217957708}{}{}\RL{مقایسه روش‌های رمزنگاری
  متقارن و نامتقارن}
\end{enumerate}

\RL{یکی از تفاوت‌های اساسی میان روش‌های رمزنگاری متقارن و نامتقارن، نحوه
مدیریت کلیدها است. در رمزنگاری نامتقارن، برخلاف رمزنگاری متقارن، نیازی
به رد و بدل کردن کلید خصوصی وجود ندارد و هر کاربر تنها از کلید عمومی
برای رمزگذاری پیام استفاده می‌کند و کلید خصوصی خود را مخفی نگه می‌دارد}.

\RL{در روش‌های متقارن، کلید رمزگذاری و رمزگشایی یکسان است و همواره خطر
دسترسی غیرمجاز نفوذگر به کلید در زمان انتقال آن وجود دارد. بنابراین،
امنیت روش‌های متقارن وابسته به حفظ محرمانگی کلید و وجود کانال امن برای
انتقال آن است}.

