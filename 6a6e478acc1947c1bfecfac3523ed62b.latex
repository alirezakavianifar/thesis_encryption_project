\item
  \RL{استخراج کلید با} SHA-512 \RL{یا} SHA-3 \RL{از تصویر اصلی برای
  افزایش امنیت}.
\item
  \RL{اعمال چند دور رمزنگاری با حالت زنجیره‌ای} (CBC-like) \RL{برای
  افزایش اثر دیفرانسیلی}.
\item
  \RL{گسترش الگوریتم به رمزنگاری ویدئو و تصاویر پزشکی با حجم بالا}.
\item
  \RL{پیاده‌سازی روی} FPGA \RL{و مقایسه مصرف توان و کارایی واقعی}.
\item
  \RL{ترکیب الگوریتم با روش‌های یادگیری عمیق برای رمزنگاری تطبیقی و
  هوشمند}.
\end{enumerate}

