\textbf{\RL{پیوست:}}

\textbf{\RL{کد اجرایی الگوریتم (پایتون)}}

import numpy as np

import cv2

import time

import os

import matplotlib.pyplot as plt

from scipy.integrate import solve\_ivp

\emph{\# =========================================================}

\emph{\# Resize utility}

\emph{\# =========================================================}

def resize\_to\_square(\emph{img}, \emph{size}):

~ ~ return cv2.resize(\emph{img}, (\emph{size}, \emph{size}),
\emph{interpolation}=cv2.INTER\_AREA)

\emph{\# =========================================================}

\emph{\# Base chaotic maps}

\emph{\# =========================================================}

def base\_logistic(\emph{x}, \emph{r}=3.99):

~ ~ return \emph{r} * \emph{x} * (1 - \emph{x})

def base\_sine(\emph{x}, \emph{r}=0.99):

~ ~ return \emph{r} * np.sin(np.pi * \emph{x})

def base\_tent(\emph{x}, \emph{r}=1.99):

~ ~ return \emph{r} * \emph{x} if \emph{x} \textless{} 0.5 else \emph{r}
* (1 - \emph{x})

\emph{\# =========================================================}

\emph{\# Exponential Chaotic Model (9 maps)}

\emph{\# =========================================================}

def make\_ecm\_func(\emph{base}, \emph{exp}):

~ ~ base\_f = \{\textquotesingle L\textquotesingle: base\_logistic,
\textquotesingle S\textquotesingle: base\_sine,
\textquotesingle T\textquotesingle: base\_tent\}{[}\emph{base}{]}

~ ~ exp\_f ~= \{\textquotesingle L\textquotesingle: base\_logistic,
\textquotesingle S\textquotesingle: base\_sine,
\textquotesingle T\textquotesingle: base\_tent\}{[}\emph{exp}{]}

~ ~ return lambda \emph{x}: base\_f(\emph{x}) ** (1 + exp\_f(\emph{x}))

ecm\_names =
{[}\textquotesingle LEL\textquotesingle,\textquotesingle LES\textquotesingle,\textquotesingle LET\textquotesingle,\textquotesingle SEL\textquotesingle,\textquotesingle SES\textquotesingle,\textquotesingle SET\textquotesingle,\textquotesingle TEL\textquotesingle,\textquotesingle TES\textquotesingle,\textquotesingle TET\textquotesingle{]}

ecm\_funcs = {[}{]}

for name in ecm\_names:

~ ~ ecm\_funcs.append(make\_ecm\_func(name{[}0{]}, name{[}2{]}))

\emph{\# =========================================================}

\emph{\# Chen chaotic system (Permutation key)}

\emph{\# =========================================================}

def chen\_system(\emph{t}, \emph{state}, \emph{a}=35, \emph{b}=3,
\emph{c}=28):

~ ~ x, y, z = \emph{state}

~ ~ dx = \emph{a} * (y - x)

~ ~ dy = (\emph{c} - \emph{a}) * x - x * z + \emph{c} * y

~ ~ dz = x * y - \emph{b} * z

~ ~ return {[}dx, dy, dz{]}

def generate\_chen\_key(\emph{n}):

~ ~ t\_eval = np.linspace(0, 50, \emph{n})

~ ~ sol = solve\_ivp(chen\_system, (0, 50), {[}0.1, 0.2, 0.3{]},

~ ~ ~ ~ ~ ~ ~ ~ ~ ~ \emph{t\_eval}=t\_eval, \emph{method}="RK45")

~ ~ data = sol.y{[}0{]}

~ ~ return ((data - data.min()) / (data.max() - data.min()) *
255).astype(np.uint8)

\emph{\# =========================================================}

\emph{\# Permutation}

\emph{\# =========================================================}

def permute\_image(\emph{img}, \emph{seed}):

~ ~ h, w, c = \emph{img}.shape

~ ~ flat = \emph{img}.reshape(-1, 3)

~ ~ np.random.seed(\emph{seed})

~ ~ idx = np.random.permutation(len(flat))

~ ~ return flat{[}idx{]}.reshape(h, w, c), idx

def invert\_permutation(\emph{img}, \emph{idx}):

~ ~ flat = \emph{img}.reshape(-1, 3)

~ ~ inv = np.empty\_like(flat)

~ ~ inv{[}\emph{idx}{]} = flat

~ ~ return inv.reshape(\emph{img}.shape)

\emph{\# =========================================================}

\emph{\# Selector + ECM keystream}

\emph{\# =========================================================}

def generate\_selector(\emph{n}, \emph{seed}):

~ ~ np.random.seed(\emph{seed})

~ ~ return np.random.randint(0, len(ecm\_funcs), \emph{size}=\emph{n})

def generate\_ecm\_keystream(\emph{n}, \emph{selector}):

~ ~ ks = np.zeros(\emph{n}, \emph{dtype}=np.uint8)

~ ~ x = 0.123456 ~\emph{\# initial key}

~ ~ for i in range(\emph{n}):

~ ~ ~ ~ x = ecm\_funcs{[}\emph{selector}{[}i{]}{]}(x)

~ ~ ~ ~ ks{[}i{]} = int((x \% 1) * 255)

~ ~ return ks

\emph{\# =========================================================}

\emph{\# Encryption / Decryption}

\emph{\# =========================================================}

def encrypt\_image(\emph{img}, \emph{seed}=42):

~ ~ h, w, c = \emph{img}.shape

~ ~ total = h * w * c

~ ~ permuted, idx = permute\_image(\emph{img}, \emph{seed})

~ ~ ks\_chen = generate\_chen\_key(total)

~ ~ selector = generate\_selector(total, \emph{seed})

~ ~ ks\_ecm = generate\_ecm\_keystream(total, selector)

~ ~ flat = permuted.reshape(-1)

~ ~ cipher = flat \^{} ks\_chen \^{} ks\_ecm

~ ~ return cipher.reshape(h, w, c), idx, ks\_chen, ks\_ecm, selector

def decrypt\_image(\emph{cipher}, \emph{idx}, \emph{ks\_chen},
\emph{ks\_ecm}):

~ ~ flat = \emph{cipher}.reshape(-1)

~ ~ plain\_flat = flat \^{} \emph{ks\_chen} \^{} \emph{ks\_ecm}

~ ~ plain = plain\_flat.reshape(\emph{cipher}.shape)

~ ~ return invert\_permutation(plain, \emph{idx})

\emph{\# =========================================================}

\emph{\# Analysis}

\emph{\# =========================================================}

def shannon\_entropy(\emph{img}):

~ ~ flat = \emph{img}.flatten()

~ ~ prob = np.bincount(flat, \emph{minlength}=256) / len(flat)

~ ~ prob = prob{[}prob \textgreater{} 0{]}

~ ~ return -np.sum(prob * np.log2(prob))

def NPCR\_UACI(\emph{img1}, \emph{img2}):

~ ~ D = \emph{img1} != \emph{img2}

~ ~ NPCR = np.sum(D) / \emph{img1}.size * 100

~ ~ UACI = np.mean(np.abs(\emph{img1}.astype(int) -
\emph{img2}.astype(int)) / 255) * 100

~ ~ return NPCR, UACI

\emph{\# =========================================================}

\emph{\# Main}

\emph{\# =========================================================}

if \_\_name\_\_ == "\_\_main\_\_":

~ ~ images = {[}"tree.png", "Baboon.png", "Peppers.png",
"Airplane.png"{]}

~ ~ os.makedirs("encrypted", \emph{exist\_ok}=True)

~ ~ os.makedirs("results", \emph{exist\_ok}=True)

~ ~ for name in images:

~ ~ ~ ~ img = cv2.imread(f"images/\{name\}")

~ ~ ~ ~ if img is None:

~ ~ ~ ~ ~ ~ print(f"Cannot open \{name\}")

~ ~ ~ ~ ~ ~ continue

~ ~ ~ ~ img = cv2.cvtColor(img, cv2.COLOR\_BGR2RGB)

~ ~ ~ ~ img = resize\_to\_square(img, 512)

~ ~ ~ ~ print(f"\textbackslash nProcessing \{name\}")

~ ~ ~ ~ t0 = time.time()

~ ~ ~ ~ enc, idx, ks1, ks2, sel = encrypt\_image(img)

~ ~ ~ ~ t1 = time.time()

~ ~ ~ ~ dec = decrypt\_image(enc, idx, ks1, ks2)

~ ~ ~ ~ t2 = time.time()

~ ~ ~ ~ cv2.imwrite(f"encrypted/\{name\}",

~ ~ ~ ~ ~ ~ ~ ~ ~ ~ cv2.cvtColor(enc, cv2.COLOR\_RGB2BGR))

~ ~ ~ ~ cv2.imwrite(f"results/dec\_\{name\}",

~ ~ ~ ~ ~ ~ ~ ~ ~ ~ cv2.cvtColor(dec, cv2.COLOR\_RGB2BGR))

~ ~ ~ ~ entropy\_o = shannon\_entropy(img)

~ ~ ~ ~ entropy\_e = shannon\_entropy(enc)

~ ~ ~ ~ NPCR, UACI = NPCR\_UACI(img, enc)

~ ~ ~ ~ print(f"Encryption time: \{t1-t0:.2f\}s \textbar{} Decryption
time: \{t2-t1:.2f\}s")

~ ~ ~ ~ print(f"Entropy: original=\{entropy\_o:.4f\},
encrypted=\{entropy\_e:.4f\}")

~ ~ ~ ~ print(f"NPCR=\{NPCR:.2f\}\%, UACI=\{UACI:.2f\}\%")

~ ~ ~ ~ print(f"Perfect recovery: \{np.array\_equal(img, dec)\}")

\end{document}
