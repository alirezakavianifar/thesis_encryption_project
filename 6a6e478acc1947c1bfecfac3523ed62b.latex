\RL{به طور کلی، مزیت اصلی رمزنگاری متقارن سرعت بالای آن و مزیت اصلی
رمزنگاری نامتقارن امنیت بالای آن است. در برخی تحقیقات، تلاش شده است که
با ترکیب این دو روش، یک روش رمزنگاری ارائه شود که هم ایمن و هم سریع باشد
(29).}

\RL{تفاوت‌های اصلی میان رمزنگاری متقارن و نامتقارن از نظر نوع کلید، نیاز
به کانال امن و مزیت‌های هر روش، به‌صورت خلاصه در} \RL{جدول (2-1) ارائه
شده} \RL{است.}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \RL{مقایسه رمزنگاری متقارن و نامتقارن}
\end{enumerate}

\begin{longtable}[]{@{}
  >{\raggedright\arraybackslash}p{(\columnwidth - 4\tabcolsep) * \real{0.2338}}
  >{\raggedright\arraybackslash}p{(\columnwidth - 4\tabcolsep) * \real{0.2541}}
  >{\raggedright\arraybackslash}p{(\columnwidth - 4\tabcolsep) * \real{0.5121}}@{}}
\toprule()
\begin{minipage}[b]{\linewidth}\raggedright
\textbf{\RL{ویژگی}}
\end{minipage} & \begin{minipage}[b]{\linewidth}\raggedright
\textbf{\RL{رمزنگاری متقارن}}
\end{minipage} & \begin{minipage}[b]{\linewidth}\raggedright
\textbf{\RL{رمزنگاری نامتقارن}}
\end{minipage} \\
\midrule()
\endhead
\RL{نوع کلید} & \RL{یک کلید} & \RL{یک کلید عمومی و یک کلید خصوصی} \\
\RL{نیاز به کانال امن} & \RL{نیازمند کانال امن} & \RL{نیاز به کانال امن
ندارد} \\
\RL{مزیت اصلی} & \RL{سرعت بالا} & \RL{امنیت بالا} \\
\bottomrule()
\end{longtable}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{4}
\item
  \protect\hypertarget{_Toc217957709}{}{}\RL{ویژگی‌های یک الگوریتم
  رمزنگاری امن}
\end{enumerate}

\RL{یک الگوریتم رمزنگاری امن باید دارای ویژگی‌های زیر باشد تا بتواند
حفاظت کامل از اطلاعات را تضمین کند (31):}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \textbf{\RL{یک‌طرفه بودن الگوریتم}:}\\
  \RL{دستیابی به متن اصلی از طریق متن رمز بدون داشتن کلید، غیرممکن باشد.
  در واقع، کلید خصوصی مانند دریچه‌ای است که تنها با در اختیار داشتن آن
  می‌توان متن رمزشده را به متن اصلی بازگرداند}.
\item
  \textbf{\RL{عدم وابستگی امنیت به محرمانه بودن الگوریتم}:}\\
  \RL{مخفی نگاه داشتن جزئیات الگوریتم در امنیت آن نقش ندارد و امنیت باید
  صرفاً بر اساس کلید مخفی تضمین شود}.
\item
  \textbf{\RL{وابستگی هر بیت متن رمزشده به تمامی بیت‌های متن اصلی}:}\\
  \RL{کوچک‌ترین تغییر در متن اصلی باید متن رمزشده کاملاً متفاوتی تولید
  کند. الگوریتم‌هایی که این ویژگی را دارند، به عنوان \textbf{رمز
  کامل}}\footnote{\textbf{Perfect Cipher}} \RL{شناخته می‌شوند}.
\item
  \textbf{\RL{وابستگی هر بیت متن رمزشده به تمامی بیت‌های کلید سری}:}\\
  \RL{در این حالت، کوچک‌ترین تغییر در کلید نیز باعث تولید متن رمزشده
  متفاوت می‌شود}.
\item
  \textbf{\RL{تأثیر تغییرات کوچک ورودی بر خروجی}:}\\
  \RL{تغییر حتی یک بیت در داده‌های ورودی، بدون تغییر کلید، باید تغییرات
  عمده‌ای در داده‌های خروجی ایجاد کند}.
\item
  \textbf{\RL{تأثیر تغییرات کوچک کلید بر متن رمزشده}:}\\
  \RL{تغییر حتی یک بیت در کلید سری، بدون تغییر متن اصلی، باید باعث ایجاد
  تغییرات عمده در متن رمزشده شود}.
\item
  \textbf{\RL{استفاده از عملیات جانشینی و جابجایی بیت‌ها تحت کنترل کلید و
  داده ورودی}:}\\
  \RL{الگوریتم باید قادر باشد بیت‌ها را جایگزین و جابجا کند تا امنیت
  اطلاعات تضمین شود}.
\item
  \textbf{\RL{دارا بودن ساختار جبری پیچیده}:}\\
  \RL{اگر تابع رمزنگاری دارای رابطه جبری ساده باشد، الگوریتم به راحتی
  قابل تحلیل و شکستن خواهد بود}.
\item
  \textbf{\RL{برابری طول متن اصلی و متن رمزشده}:}\\
  \RL{الگوریتم باید طول پیام ورودی و خروجی را حفظ کند}.
\item
  \textbf{\RL{استفاده از تمامی کلیدهای مخفی برای تولید رمز قوی}:}\\
  \RL{هر کلید باید توانایی تولید متن رمزشده قوی و غیرقابل پیش‌بینی را
  داشته باشد}.
\end{enumerate}

\RL{این خصوصیات شرایط لازم برای طراحی یک الگوریتم رمزنگاری قوی را فراهم
می‌کنند. با این حال،} \textbf{\RL{شروط لازم و کافی برای ارزیابی امنیت هر
سیستم رمزنگاری، مقاومت}} \RL{\textbf{آن در برابر انواع حملات} است. در
بخش‌های بعدی، انواع حملات و روش‌های مقابله با آن‌ها بررسی خواهد شد}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957710}{}{}\RL{تحلیل رمز: انواع حملات به
  سامانه‌های رمزنگاری}
\end{enumerate}

\RL{قضیه امنیت کامل، معیار مهمی برای طراحی سامانه‌های رمزنگاری فراهم
می‌کند؛ با این حال، طراحی سامانه‌هایی که این قضیه کاملاً برای آن‌ها صدق کند،
در عمل دشوار است. در رمزنگاری مدرن، تمرکز بیشتر بر کاربردپذیری عملی و
امنیت کافی برای محافظت از داده‌های حساس است. الگوریتم‌های رمزنگاری باید
نسبت به کلیدهای اشتباه حساس باشند و فضای کلید آن‌ها باید به اندازه کافی
بزرگ باشد تا در مقابل حملات کورکورانه و شدید مقاومت نشان دهند(34)}

\RL{یک رمزگشا یا تحلیلگر رمز سعی می‌کند بر اساس اطلاعات موجود، متن رمز
شده را رمزگشایی کند. میزان دانش تحلیلگر می‌تواند شامل متن رمزشده، دسترسی
محدود به الگوریتم رمزگذاری و رمزگشایی باشد، اما هیچگاه دسترسی به کلید
ندارد. هرچه دانش تحلیلگر بیشتر باشد، رمزگشایی آسان‌تر خواهد بود. برای
تضمین امنیت، باید اطمینان حاصل شود که معکوس تابع رمزگذاری تنها با داشتن
کلید ممکن است. در اصطلاح رمزنگاری، این توابع باید یک‌طرفه باشند}.

\RL{انواع حملات به چهار دسته اصلی تقسیم می‌شوند}:

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \textbf{\RL{حمله با متن رمزشده}}\footnote{\textbf{Ciphertext-Only
    Attack}} \RL{}
\end{enumerate}

\RL{در این نوع حمله، تحلیلگر تنها به متن رمزشده دسترسی دارد و تلاش می‌کند
متن اصلی یا کلید مورد استفاده را بیابد تا سایر پیام‌های رمز شده نیز قابل
رمزگشایی شوند. این حمله سخت‌ترین نوع حمله است و نیازمند تحلیل دقیق الگوها
و احتمالات است(35)}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{1}
\item
  \textbf{\RL{حمله با متن اصلی مشخص}} \footnote{\textbf{Known-Plaintext
    Attack}}
\end{enumerate}

\RL{در این سناریو، تحلیلگر به یک یا چند جفت متن اصلی و متن رمزشده متناظر
دسترسی دارد و از آن‌ها برای حدس زدن کلید یا الگوریتم رمزنگاری استفاده
می‌کند. هدف این است که کلید} K \RL{یا الگوریتمی پیدا شود که بتواند
پیام‌های جدید را رمزگشایی نماید}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{2}
\item
  \textbf{\RL{حمله با متن اصلی منتخب}} \footnote{\textbf{Chosen-Plaintext
    Attack}}
\end{enumerate}

\RL{در این نوع حمله، تحلیلگر می‌تواند متن‌های اصلی خاصی را برای رمزگذاری
انتخاب کند و متن‌های رمزشده متناظر را مشاهده نماید. این حمله از نوع}
Known-Plaintext \RL{قوی‌تر است، زیرا تحلیلگر می‌تواند بلوک‌های متن اصلی را
به گونه‌ای انتخاب کند که اطلاعات بیشتری درباره کلید به دست آورد. هدف،
پیدا کردن کلید} K \RL{یا الگوریتمی است که امکان رمزگشایی پیام‌های جدید با
همان کلید را فراهم کند.}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{3}
\item
  \textbf{\RL{حمله با متن رمزشده}} \textbf{\RL{منتخب}} \footnote{\textbf{Chosen-Ciphertext
    Attack}}\RL{}
\end{enumerate}

\RL{این نوع حمله، حالت خاصی از حمله متن اصلی منتخب است. در آن، تحلیلگر
می‌تواند متن‌های اصلی را انتخاب و خروجی رمزگذاری را مشاهده کند و همچنین
انتخاب‌های بعدی خود را بر اساس نتایج رمزگذاری قبلی اصلاح نماید. این حمله
تطبیقی، امکان انتخاب بلوک‌های کوچک‌تر و تحلیل دقیق‌تر کلید را فراهم می‌کند}.

\RL{این چهار دسته، اسکلت اصلی انواع حملات در رمزنگاری مدرن را تشکیل
می‌دهند. یک سامانه رمزنگاری پس از مقاومت موفق در برابر این چهار حالت،
می‌تواند ادعای امنیت داشته باشد}.

\begin{itemize}
\item
  \RL{الگوریتم‌های ساده‌تر معمولاً در برابر حملات} Ciphertext-Only \RL{و}
  Known-Plaintext \RL{آسیب‌پذیر هستند}.
\item
  \RL{برای الگوریتم‌های پیچیده‌تر، مانند رمزنگاری مبتنی بر توابع آشوب،
  معمولاً از حملات} Chosen-Plaintext \RL{و} Chosen-Ciphertext
  \RL{استفاده} \RL{می‌شود (36).}

  \begin{enumerate}
  \def\labelenumi{\arabic{enumi}.}
  \item
    \protect\hypertarget{_Toc217957711}{}{}\RL{امنیت سیستم‌های رمزنگاری}
  \end{enumerate}
\end{itemize}

\RL{امنیت سیستم‌های رمزنگاری از دیرباز یکی از مسائل کلیدی در علم رمزنگاری
بوده و همچنان اهمیت فراوان دارد. طراحی سامانه‌های رمزنگاری باید به گونه‌ای
باشد که علاوه بر کارایی عملی، حداکثر حفاظت از داده‌ها را تضمین کند}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957712}{}{}\RL{اصول شش­گانه کرشهف}
\end{enumerate}

\RL{آگوست کرشهف}\footnote{August Kerckhoffs} \RL{در سال 1883 دو مقاله با
عنوان رمزنگاری نظامی منتشر کرد که در آن‌ها شش اصل اساسی مطرح شد. این اصول
هنوز هم در طراحی سیستم‌های رمزنگاری مدرن مورد استفاده قرار می‌گیرند:(37)}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{4}
\item
  \RL{غیرقابل شکست بودن سیستم: سیستم رمزنگاری باید حتی در عمل غیرقابل
  شکست باشد}.
\item
  \RL{محرمانه بودن تنها کلید رمز: هیچ جزئیات دیگری از سیستم رمزنگاری
  نباید مخفی باشد و تنها کلید، اطلاعات محرمانه است}.
\item
  \RL{قابلیت انتخاب و تغییر کلید: کلید باید به‌راحتی قابل انتخاب، تغییر و
  حفظ باشد و نیازی به یادداشت کردن آن نباشد}.
\item
  \RL{امکان ارسال از طریق تلگراف: متون رمزشده باید قابلیت مخابره از طریق
  خطوط تلگراف یا رسانه‌های مشابه را داشته باشند}.
\item
  \RL{قابلیت حمل و نقل: دستگاه رمزنگاری یا اسناد رمز شده باید توسط یک
  نفر قابل حمل باشد}.
\item
  \RL{سهولت راه‌اندازی سیستم: سیستم رمزنگاری باید به سادگی قابل استفاده و
  راه‌اندازی باشد}. \RL{}
\end{enumerate}

\RL{در توضیح قانون دوم کرشهف باید عنوان کرد که به چند دلیل عمده کلید رمز
باید تنها اطالعات} \RL{محرمانه در یک سیستم رمزنگاری باشد:}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \RL{سادگی حفظ محرمانگی کلید نسبت به الگوریتم: محرمانه نگه داشتن یک
  رشته بیت (مثلاً 512 بیت) بسیار ساده‌تر و عملی‌تر از پنهان نگاه داشتن کل
  الگوریتم یا روش پیاده‌سازی است}.
\item
  \RL{تجدید امنیت در صورت افشای کلید: در صورت افشای کلید، تنها با تعویض
  کلید می‌توان مجدداً به امنیت دست یافت؛ در حالی که وابستگی به الگوریتم،
  افشای آن را به یک مسئله بسیار پیچیده تبدیل می‌کند}.
\item
  \RL{امکان استفاده از سیستم مشترک برای چند گیرنده/فرستنده: اگر کلید
  تنها اطلاعات محرمانه باشد، می‌توان با کلیدهای متفاوت با گیرنده‌ها و
  فرستنده‌های مختلف ارتباط برقرار کرد؛ در غیر این صورت، برای هر جفت
  فرستنده/گیرنده نیاز به الگوریتم جدید است}.
\item
  \RL{بازرسی و اصلاح الگوریتم‌های عمومی توسط محققان: وقتی الگوریتم و روش
  پیاده‌سازی عمومی باشد، محققان امنیتی می‌توانند مشکلات و حفره‌های احتمالی
  آن را پیش از سوء استفاده توسط حمله‌گران شناسایی و رفع کنند؛ بنابراین،
  سیستم‌های رمزنگاری مبتنی بر الگوریتم‌های عمومی معمولاً قابل اعتمادتر
  هستند (38).}

  \begin{enumerate}
  \def\labelenumii{\arabic{enumii}.}
  \item
    \protect\hypertarget{_Toc217957713}{}{}\RL{معیارهای پنجگانه شانون}
  \end{enumerate}
\end{enumerate}

\RL{در سال ۱۹۴۸، کلاد شانون}\footnote{Claude Shannon} \RL{مقاله‌ای با
عنوان یک نظریه ریاضیاتی از ارتباطات منتشر کرد که در دو بخش ارائه شد. در
این مقاله، شانون به بررسی بهترین روش کدگذاری اطلاعات برای مخابره توسط
فرستنده پرداخت و پنج معیار اساسی برای ارزیابی سیستم‌های رمزنگاری معرفی
نمود: (39)}

\RL{۱}. \RL{میزان ایمنی سیستم}

\RL{برخی سیستم‌ها امنیت کامل دارند و هیچ مهاجمی نمی‌تواند آن‌ها را شکسته یا
به داده‌ها دسترسی یابد. در برخی سیستم‌ها، مهاجم ممکن است اطلاعاتی کسب کند
که منجر به جواب یکتا نشود و حتی در مواردی که پاسخ یکتا حاصل شود، پیچیدگی
محاسبات و زمان لازم برای شکستن رمز مانع آسیب به امنیت سیستم می‌شود}.

\RL{۲}. \RL{اندازه کلید}

\RL{کلید باید به روشی مطمئن و غیرقابل دسترس در اختیار گیرنده قرار گیرد،
به‌گونه‌ای که حتی در شرایط اضطراری نیز امکان استفاده از آن وجود داشته
باشد. بنابراین، داشتن کلید کوچک و ساده تا حد امکان مطلوب است}.

\RL{۳}. \RL{پیچیدگی عملیات رمزنگاری و رمزگشایی}

\RL{عملیات رمزگذاری و رمزگشایی باید ساده، سریع و با هزینه کم انجام شود
تا کارایی سیستم حفظ گردد}.

\RL{۴}. \RL{انتشار خطا} \footnote{Error Propagation}

\RL{اگر در فرآیند رمزگذاری یا انتقال پیام، خطایی رخ دهد، ممکن است این
خطا در متن بازگشایی شده گسترش یافته و باعث از دست رفتن مقدار زیادی
اطلاعات شود. سیستم باید طوری طراحی شود که انتشار خطا به حداقل برسد}.

\RL{۵}. \RL{بسط یا گسترش پیام}

\RL{در برخی سیستم‌ها، پس از رمزگذاری، اندازه پیام افزایش می‌یابد. به‌ویژه
در سیستم‌هایی که قصد حذف فرکانس طبیعی سمبل‌ها را دارند، ممکن است از
سمبل‌های خنثی یا تکرار سمبل‌ها استفاده شود. این امر در سیستم‌های مخابراتی
مطلوب نیست و باید از آن جلوگیری شود.}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957714}{}{}\RL{ویژگی‌های نرم‌افزاری الگوریتم
  رمز}
\end{enumerate}

\RL{در طراحی الگوریتم‌های رمزنگاری، رعایت ویژگی‌های نرم‌افزاری اهمیت زیادی
دارد تا پیاده‌سازی سریع، پایدار و مقاوم در برابر اختلال‌ها حاصل شود. برخی
از ویژگی‌های کلیدی عبارتند از(41)}

\RL{اجتناب از پرش‌های شرطی در حلقه‌های داخلی الگوریتم}:

\RL{هرگونه تغییر غیرقابل پیش‌بینی در جریان کنترل الگوریتم، موجب اختلال در
عملکرد پردازش و افزایش تعداد سیکل‌های ساعت مورد نیاز می‌شود}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \RL{استفاده محدود از عملگرهای سنگین}:
\end{enumerate}

\RL{عملگرهایی مانند ضرب و تقسیم یا سایر عملگرهای پیچیده که اجرای آن‌ها بر
روی پردازنده‌ها دشوار است، باید به حداقل برسند تا کارایی الگوریتم کاهش
نیابد}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{1}
\item
  \RL{محدود کردن تعداد متغیرها در طرح الگوریتم}:
\end{enumerate}

\RL{هرچند بسیاری از پردازنده‌های مدرن دارای ثبات‌های متعدد چندمنظوره
هستند، اما برخی پردازنده‌ها محدودیت دارند و استفاده بهینه از متغیرها
ضروری است}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{2}
\item
  \RL{کوچک نگه داشتن اندازه جداول}:
\end{enumerate}

\RL{هرچند جداول بزرگ از نظر امنیتی مطلوب‌تر هستند، اما برای اجرای سریع‌تر
نرم‌افزاری باید اندازه آن‌ها محدود باشد. توصیه می‌شود جداول به گونه‌ای طراحی
شوند که بیش از ۴ کیلوبایت حافظه نیاز نداشته باشند}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{3}
\item
  \RL{بهره‌گیری از الگوهای موازی در عملگرها}:
\end{enumerate}

\RL{اجرای همزمان و مستقل عملگرها می‌تواند به‌طور قابل توجهی سرعت اجرای
الگوریتم را افزایش دهد. استفاده از موازی‌سازی در طراحی نرم‌افزاری، یکی از
روش‌های مؤثر برای بهینه‌سازی عملکرد است}.

\RL{رعایت نکات فوق، هرچند ساده به نظر می‌رسد، اما تاثیر قابل توجهی در
افزایش سرعت و کارایی پیاده‌سازی نرم‌افزاری الگوریتم‌های رمزنگاری دارد و یکی
از الزامات طراحی بهینه محسوب می‌شود.}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957715}{}{}\RL{رمزنگاری تصویر دیجیتال}
\end{enumerate}

\RL{با گسترش شبکه‌های عمومی مانند اینترنت و افزایش فناوری‌های سیگنال
دیجیتال، استفاده از تصاویر دیجیتال در کاربردهای مختلف روزبه‌روز رایج‌تر
شده است و رشد آن همچنان ادامه دارد (43). در این میان، یکی از چالش‌های
اصلی، تضمین امنیت تصاویر و جلوگیری از دسترسی غیرمجاز به اطلاعات حساس
است}.

\RL{یک راهکار مستقیم برای رفع این مشکل، استفاده از رمزنگاری تصاویر است.
رمزنگاری می‌تواند محتوای تصویر را پنهان کرده و از دسترسی غیرمجاز جلوگیری
نماید}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957716}{}{}\RL{محدودیت‌های روش‌های سنتی
  رمزنگاری برای تصاویر}
\end{enumerate}

\RL{روش‌های کلاسیک رمزنگاری، مانند}:

\begin{itemize}
\item
  \RL{روش‌های مبتنی بر نظریه اعداد،}
\item
  \RL{روش‌های رمزنگاری استاندارد ساده،}
\item
  \RL{و روش} RSA
\end{itemize}

\RL{برای رمزنگاری تصویر دیجیتال کارا نیستند (44). دلایل اصلی عبارتند
از}:

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \RL{حجم بالای تصاویر}:
\end{enumerate}

\RL{تصاویر دیجیتال معمولاً حجم زیادی دارند، و الگوریتم‌های سنتی نیازمند
پردازش طولانی و توان محاسباتی بالا هستند}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{1}
\item
  \RL{زمان رمزگذاری و رمزگشایی طولانی}:
\end{enumerate}

\RL{در ارتباطات بلادرنگ، سرعت پایین این الگوریتم‌ها ممکن است باعث تاخیر
قابل توجه شود}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{2}
\item
  \RL{همبستگی پیکسل‌های مجاور و یکنواختی رنگ}:
\end{enumerate}

\RL{الگوریتم‌های سنتی به دلیل وجود همبستگی بین پیکسل‌ها و زمینه‌های یکنواخت
تصویر، قادر به ایجاد امنیت کافی نیستند}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{3}
\item
  \RL{نیازمندی‌های خاص برنامه‌های کاربردی تصویر}:
\end{enumerate}

\RL{برخی برنامه‌ها نیازمند همزمان برآورده کردن مواردی مانند ذخیره صحیح،
پردازش بدون وقفه، فشرده‌سازی اطلاعات و ثبات فرمت تصویر هستند. روش‌های سنتی
معمولاً نمی‌توانند همزمان این نیازها و امنیت بالا را تأمین کنند}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957717}{}{}\RL{ضرورت توسعه الگوریتم‌های
  ویژه رمزنگاری تصویر}
\end{enumerate}

\RL{با توجه به محدودیت‌های فوق، الگوریتم‌های ویژه رمزنگاری تصویر مورد نیاز
هستند که بتوانند}:

\begin{itemize}
\item
  \RL{حجم بالای داده‌ها را به‌طور بهینه مدیریت کنند،}
\item
  \RL{سرعت رمزگذاری و رمزگشایی بالا داشته باشند،}
\item
  \RL{امنیت مناسبی برای جلوگیری از دسترسی غیرمجاز فراهم کنند،}
\item
  \RL{و همزمان نیازمندی‌های پردازشی و فشرده‌سازی تصویر را برآورده سازند
  (45).}

  \begin{enumerate}
  \def\labelenumi{\arabic{enumi}.}
  \item
    \protect\hypertarget{_Toc217957718}{}{}\RL{خصوصیات تصویر دیجیتال}

    \begin{enumerate}
    \def\labelenumii{\arabic{enumii}.}
    \item
      \protect\hypertarget{_Toc217957719}{}{}\RL{پیکسل در تصویر}
    \end{enumerate}
  \end{enumerate}
\end{itemize}

\RL{در تصاویر دیجیتال، پیکسل کوچک‌ترین واحد ساختاری تصویر محسوب می‌شود
(46). پیکسل گاهی در مباحث گرافیکی و تصویری به عنوان نقطه نیز شناخته
می‌شود و نقش کوچک‌ترین نقطه تشکیل‌دهنده تصویر را ایفا می‌کند}.

\RL{همانطور که بیت کوچک‌ترین واحد اطلاعات قابل پردازش توسط کامپیوتر است،
پیکسل نیز کوچک‌ترین عنصر سخت‌افزاری و نرم‌افزاری نمایش یا چاپ تصویر است که
برای شکل‌گیری تصاویر دیجیتال به کار می‌رود}.

\RL{اگر برای هر پیکسل دو رنگ مانند سیاه و سفید در نظر گرفته شود، می‌توان
آن را با یک بیت نمایش داد. در صورتی که بیش از دو بیت برای هر پیکسل
استفاده شود، محدوده رنگ‌ها و سایه‌های خاکستری گسترده‌تری قابل ارائه خواهد
بود. این ویژگی اساس نمایش تصاویر رنگی و توانایی تفکیک رنگ‌ها را فراهم
می‌کند.}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{1}
\item
  \protect\hypertarget{_Toc217957720}{}{}\RL{عمق رنگ}
\end{enumerate}

\RL{عمق رنگ تعداد رنگ‌هایی است که یک پیکسل می‌تواند تولید کند، و عمق بیتی
تعداد بیت‌هایی است که برای تولید این رنگ‌ها اختصاص داده می‌شود}

\RL{برای تصاویر تک‌رنگ، یک بیت برای نمایش هر پیکسل کافی است، اما در
تصاویر رنگی و تصاویر با سایه‌های خاکستری، هر پیکسل نیاز به بیش از یک بیت
دارد. هرچه تعداد بیت‌های بیشتری برای نمایش پیکسل اختصاص یابد، تعداد رنگ‌ها
و سایه‌های قابل نمایش افزایش می‌یابد}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{2}
\item
  \protect\hypertarget{_Toc217957721}{}{}\RL{ابعاد تصویر}
\end{enumerate}

\RL{تصاویر دیجیتال معمولاً به صورت شبکه‌های مربعی شکل نمایش داده می‌شوند که
شبیه صفحه شطرنج یا موزاییک‌های کف هستند (48). این شبکه‌ها از مربع‌های
کوچکتری به نام پیکسل تشکیل شده‌اند}.

\RL{ابعاد شبکه معادل تعداد پیکسل‌های طول و عرض تصویر است و ارتباطی با
اندازه واقعی تصویر ندارد. برای مثال، یک شبکه 1280×720 نشان‌دهنده تعداد
پیکسل‌های طول و عرض تصویر است، نه اندازه فیزیکی آن}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{3}
\item
  \protect\hypertarget{_Toc217957722}{}{}\RL{مدل‌های رنگ}
\end{enumerate}

\RL{مدل‌های رنگ به منظور استانداردسازی نمایش رنگ‌ها استفاده می‌شوند و هر
رنگ در تصویر با یک پیکسل مشخص می‌شود (49). اکثر مدل‌های رنگی به سمت
سخت‌افزار (مانند مانیتور و چاپگر) یا کاربردهای تولید گرافیک و تصویر رنگی
گرایش دارند}.

\RL{مدل‌های رایج عبارتند از}:

\begin{itemize}
\item
  RGB \RL{(قرمز، سبز، آبی): مدل} RGB \RL{برای نمایشگرهای رنگی و
  دوربین‌های دیجیتال استفاده می‌شود. هر پیکسل از ترکیب نورهای قرمز، سبز و
  آبی تشکیل شده و مقدار هر رنگ عددی بین 0 تا 255 است. این مدل بر پایه
  سیستم مختصات کارتزین تعریف می‌شود و زیرفضای رنگی آن مکعبی است که سیاه
  در مبدأ و سفید در دورترین گوشه قرار دارد. این مدل برای پردازش تصویر و
  نمایش طبیعی رنگ‌ها بسیار پرکاربرد است}.
\item
  CMY \RL{(آبی فیروزه‌ای، بنفش، زرد): بیشتر برای چاپگرهای رنگی کاربرد
  دارد}.
\item
  : YIQ \RL{استاندارد تلویزیون رنگی، شامل لومینانس} (Y) \RL{و دو مؤلفه
  رنگی} I \RL{و} Q \RL{که به ترتیب هم‌فاز و متعامد هستند}.
\item
  HIS \footnote{(Hue\RL{،} Saturation\RL{،} Intensity)} \RL{: برای
  پردازش و تحلیل تصویر رنگی استفاده می‌شود}.
\end{itemize}

\RL{مدل} RGB \RL{یکی از مهم‌ترین مدل‌های رنگی برای پردازش تصویر دیجیتال به
شمار می‌رود، زیرا هر تصویر شامل سه صفحه مستقل است که هر صفحه به یک رنگ
اولیه اختصاص دارد و ترکیب این سه صفحه روی نمایشگر، تصویر نهایی رنگی را
ایجاد می‌کند.}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957723}{}{}\RL{مولفه‌های مهم یک روش
  رمزنگاری تصویر}
\end{enumerate}

\RL{برای طراحی یک الگوریتم رمزنگاری تصویر مؤثر، توجه به چند ویژگی کلیدی
ضروری است}: \RL{}

\RL{کاهش اضافات و حجم داده: اضافات زیاد و حجم بالا در داده‌های تصاویر
رمزشده، معمولاً باعث آسیب‌پذیری آنها در برابر تحلیلگران و حملات آماری
می‌شود (50). حجم زیاد اطلاعات، امکان استخراج نمونه‌های کافی از متن رمزشده
برای تحلیل آماری را فراهم می‌کند، به‌ویژه زمانی که الگوریتم از طول محدود و
نسبتاً کوتاه استفاده کند. کاهش حجم داده‌ها و ساده‌تر کردن الگوریتم می‌تواند
بار محاسباتی را کاهش دهد و امنیت را بهبود بخشد}.

\RL{ایجاد همبستگی ضعیف میان پیکسل‌ها: تحلیل آماری نشان داده است که
پیکسل‌های مجاور، چه به صورت افقی، عمودی و چه قطری، معمولاً همبستگی زیادی
دارند . این همبستگی شدید باعث کند شدن پراکندگی یا درهم‌ریزی پیکسل‌ها
می‌شود. با تکرار الگوریتم و استفاده از مکانیزم‌های تصادفی‌ساز، می‌توان این
همبستگی‌ها را کاهش داد و امنیت تصویر رمزشده را افزایش داد}.

\RL{غیرقابل پیش‌بینی بودن تصویر رمزشده: براساس تئوری اطلاعات شانون، یک
سیستم رمزنگاری ایمن باید آنتروپی بالایی داشته باشد و تصویر رمزشده نباید
هیچ اطلاعاتی درباره تصویر اصلی فاش کند. برای رسیدن به این هدف، تصویر
رمزشده باید تا حد امکان تصادفی باشد، هیستوگرام متوازن داشته باشد و هیچ
همبستگی آماری بین پیکسل‌های مجاور وجود نداشته باشد. دستیابی به این سطح
امنیت نیازمند چندین مرحله جابجایی و جانشانی پیچیده است}.

\RL{سرعت رمزنگاری و هزینه محاسباتی: یک الگوریتم ایمن که بسیار کند اجرا
شود یا نیازمند هزینه محاسباتی بالا باشد، برای کاربردهای زمان واقعی ارزش
عملی کمی خواهد داشت (53). بنابراین، سرعت بالا و مصرف منابع کم در طراحی
الگوریتم اهمیت ویژه‌ای دارد}.

\RL{فشرده‌سازی داده‌ها همراه با امنیت: رمزنگاری تصویر معمولاً همزمان با
فشرده‌سازی داده‌ها انجام می‌شود، زیرا تصاویر دیجیتال حجم بالایی دارند و
اغلب دارای اطلاعات اضافی هستند (54). ادغام نیازهای امنیتی با فرایند
فشرده‌سازی، چالشی مهم است که باید بدون کاهش کیفیت فشرده‌سازی، امنیت مناسبی
را تضمین کند}.

\RL{تغییر تصویر به نحوی که قابلیت تشخیص نداشته باشد: بینایی انسان نسبت
به تغییرات جزئی تصویر حساس نیست، بنابراین الگوریتم باید بتواند بیت‌های
مرتبط و همبسته تصویر را به‌طور مؤثر رمز کند (55). در روش‌های سنتی، برخی
شباهت‌ها حتی پس از رمزگذاری باقی می‌مانند و نیازمند توان محاسباتی بالا
برای پوشش تمام بیت‌های تصویر هستند. الگوریتم بهینه باید این تغییرات را
بدون افزایش غیرضروری هزینه محاسبات اعمال کند. (42).}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957724}{}{}\RL{نظریه‌ی آشوب و مفاهیم بنیادی
  آن}
\end{enumerate}

\RL{نظریه آشوب، گسترش خود را بیشتر مدیون پژوهش‌های دانشمندانی همچون هانری
پوانکاره، ادوارد لورنز، بنوا مندلبروت و مایکل فیگنباوم است. پوانکاره
نخستین فردی بود که اثبات کرد مسئله سه‌جسمی (مانند خورشید، زمین و ماه) یک
مسئله آشوبی و غیرقابل‌حل دقیق است. شاخه‌ای از این نظریه که در مکانیک
کوانتومی به‌کار می‌رود، «آشوب کوانتومی» نام دارد. گفته می‌شود که حتی پیر
لَپلاس و عمر خیام نیز پیش از پوانکاره به وجود چنین پدیده‌هایی پی برده
بودند.}

\RL{اولین آزمایش واقعی در زمینه آشوب توسط ادوارد لورنز، هواشناس
آمریکایی، در سال 1961 انجام شد. وی هنگام کار بر روی مدل‌های عددی پیش‌بینی
وضعیت آب‌وهوا دریافت که تغییرات بسیار جزئی در شرایط اولیه می‌تواند منجر به
تغییرات چشمگیر در نتایج نهایی شود. این پدیده که بعدها با عنوان اثر
پروانه‌ای}\footnote{Butterfly Effect} \RL{شناخته شد، نشان‌دهنده‌ی حساسیت
بسیار بالای سیستم‌های آشوبی نسبت به شرایط اولیه است} \RL{(57)}

\RL{لورنز در سال 1972 مقاله‌ای با عنوان «آیا بال‌زدن پروانه‌ای در برزیل
می‌تواند موجب وقوع گردبادی در تگزاس شود؟» منتشر کرد و در سال 1993 نیز
کتاب معروف خود با عنوان} The Essence of Chaos \RL{را به چاپ رساند. در
ادامه، بنوا مندلبروت در سال 1967 در جریان مطالعه‌ای پیرامون اندازه‌گیری
طول سواحل بریتانیا، مفاهیم بعد فراکتال و خودهمانندی} \footnote{Self-Similarity}
\RL{را مطرح نمود. او در سال 1975 نیز مقاله‌ی تأثیرگذاری با عنوان} The
Fractal Geometry of Nature \RL{منتشر کرد که بنیان نظریه‌ی هندسه‌ی فراکتالی
و بخش مهمی از نظریه‌ی آشوب را تشکیل داد. از سوی دیگر، مایکل فیگنباوم در
سال 1977 مقاله‌ای تحت عنوان} Quantitative Universality for a Class of
Nonlinear Transformations \RL{ارائه کرد که در آن با بررسی نگاشت لجستیک
موفق به کشف پدیده‌ی جهان‌شمولی آشوب شد و نسبت‌های عددی خاصی را برای توصیف
رفتار سامانه‌های غیرخطی به‌دست آورد. (39).}

\includegraphics[width=2.13352in,height=1.96684in]{vertopal_6a6e478acc1947c1bfecfac3523ed62b/media/image2.png}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \RL{اثر پروانه­ای}
\end{enumerate}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957725}{}{}\RL{تعریف آشوب}
\end{enumerate}

\RL{در لغت، «آشوب» به معنای بی‌نظمی، درهم‌ریختگی و آشفتگی است و در علم
مکانیک مترادف با واژه «تلاطم» به کار می‌رود. این واژه در ظاهر به نبود
هرگونه نظم یا ساختار اشاره دارد و در زبان روزمره، نشانه‌ای از نابسامانی و
بی‌سازمانی تلقی می‌شود. بااین‌حال، با گسترش دیدگاه‌های نوین علمی، مفهوم آشوب
دیگر به معنای صرفِ بی‌نظمی و ناکارآمدی در نظر گرفته نمی‌شود؛ بلکه بیانگر
نوعی رفتار غیرقابل پیش‌بینی در سامانه‌های پویاست که خود از نظمی درونی و
پیچیده تبعیت می‌کند. به عبارتی، در دل بی‌نظمی، نوعی نظم نهفته وجود دارد که
تنها در مقیاس‌های متفاوت آشکار می‌شود(37)}

\RL{پدیده‌ی آشوب معمولاً در نتیجه‌ی تعاملات پیچیده‌ی درونی اجزای یک سیستم و
به‌ویژه در سامانه‌های غیرخطی و زیستی پدید می‌آید. در چنین سیستم‌هایی،
تغییرات ناگهانی می‌تواند به رفتارهایی منجر شود که ماهیت تصادفی یا
غیر‌دوره‌ای دارند و به آن‌ها رفتار آشوب‌گونه گفته می‌شود. بسیاری از این
سیستم‌ها، هرچند رفتارشان ظاهراً نامنظم است، در واقع از قوانین دقیق و قطعی
تبعیت می‌کنند؛ ازاین‌رو به آن‌ها آشوب معین}\footnote{Deterministic Chaos}
\RL{گفته می‌شود}.

\RL{سیستم‌های آشوبی در اصل، سیستم‌های دینامیکی غیرخطی هستند که حالت آن‌ها
با گذر زمان تغییر می‌کند و آینده‌ی رفتارشان به‌شدت به شرایط اولیه وابسته
است. اساس نظریه‌ی آشوب بر این فرض استوار است که در هر بی‌نظمی، نظمی پنهان
وجود دارد. به بیان دیگر، هنگامی‌که جایگاه یا وضعیت بعدی یک سیستم به‌صورت
دقیق قابل پیش‌بینی نباشد، آن سیستم را آشفته یا نامنظم می‌نامند. چنین
سامانه‌ای هیچ‌گاه دوبار دقیقاً در یک حالت تکرار نمی‌شود}.

\RL{بااین‌حال، طبق نظریه‌ی آشوب، اگر رفتار چنین سیستمی در طول زمان به‌دقت
مشاهده شود، می‌توان الگویی از نظم ذاتی را در پسِ حرکات تصادفی آن یافت. حتی
سیستم‌هایی که در ظاهر بی‌قاعده و غیرقابل‌پیش‌بینی هستند، در محدوده‌ی معینی از
فضا و زمان حرکت می‌کنند و از مرزهای مشخص خود فراتر نمی‌روند. بدین ترتیب،
پدیده‌هایی که در مقیاس کوچک آشفته به نظر می‌رسند، ممکن است در مقیاس بزرگ‌تر
رفتاری منظم و پایدار داشته باشند. در حقیقت، در دل هر بی‌نظمی و آشفتگی،
نوعی الگوی پنهان از نظم وجود دارد که جلوه‌ای زیبا و قابل‌درک از پیچیدگی
طبیعت را آشکار می‌سازد {[}11{]}.}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{1}
\item
  \protect\hypertarget{_Toc217957726}{}{}\RL{نظریه آشوب}
\end{enumerate}

\RL{نظریه آشوب یا نظریه بی‌نظمی‌ها، به بررسی و تحلیل سیستم‌های دینامیکی
آشوبناک می‌پردازد. این سیستم‌ها در واقع سامانه‌های دینامیکی غیرخطی هستند که
رفتار آن‌ها به شدت به شرایط اولیه وابسته است؛ به‌طوری‌که حتی تغییرات بسیار
جزئی در مقدار اولیه متغیرها می‌تواند به نتایج کاملاً متفاوتی در آینده منجر
شود. این ویژگی شاخص، با عنوان مشهور «اثر پروانه‌ای}\footnote{Butterfly
  Effect}\RL{» شناخته می‌شود؛ پدیده‌ای که نخستین‌بار توسط ادوارد لورنز در
دهه 1960 میلادی معرفی شد(21).}

\RL{رفتار سیستم‌های آشوبی در نگاه نخست تصادفی و غیرقابل پیش‌بینی به نظر
می‌رسد، اما در واقعیت، چنین سیستم‌هایی از قوانین کاملاً قطعی و معین پیروی
می‌کنند. به همین دلیل، آشوب را نمی‌توان ناشی از وجود عنصر تصادف دانست؛
بلکه این رفتار حاصل غیرخطی بودن روابط درونی سیستم و حساسیت بالا به شرایط
اولیه است}.

\RL{از دیدگاه نظری، وجود رفتار آشوب‌گونه در یک سیستم دینامیکی مستلزم آن
است که سامانه حداقل دارای سه متغیر حالت مستقل باشد. به عبارت دیگر، تنها
در سیستم‌های مرتبه سه یا بالاتر است که امکان ظهور آشوب وجود دارد. نمونه‌ای
کلاسیک از چنین سیستمی، مدل لورنز است که برای توصیف رفتار همرفت در جوّ
زمین ارائه شده است}.

\RL{در مقابل، در سیستم‌های دینامیکی زمان‌گسسته، وجود تنها یک متغیر حالت
نیز می‌تواند برای بروز رفتار آشوبی کافی باشد. یکی از نمونه‌های مشهور در
این زمینه، نگاشت لجستیک است که برای مدل‌سازی تغییرات جمعیتی در اکوسیستم‌ها
به‌کار می‌رود. این مدل نشان می‌دهد که چگونه یک رابطه ساده غیرخطی می‌تواند
منجر به رفتار پیچیده، غیرتناوبی و آشوب‌گونه شود.}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{2}
\item
  \protect\hypertarget{_Toc217957727}{}{}\RL{ویژگی‌های تئوری آشوب}
\end{enumerate}

\RL{تئوری آشوب به عنوان یکی از مفاهیم بنیادی در بررسی سیستم‌های دینامیکی
غیرخطی، دارای ویژگی‌هایی است که آن را از سایر نظریه‌های کلاسیک متمایز
می‌کند. در} \RL{ادامه به دو ویژگی مهم} \RL{آن اشاره می‌شود}:

\RL{الف) اثر پروانه‌ای} \RL{}

\RL{لورنتز در تحقیقات خود دریافت که تغییرات بسیار جزئی در شرایط اولیه‌ی
معادلات پیش‌بینی‌کننده‌ی جوّی می‌تواند منجر به تفاوت‌های بسیار بزرگ در نتایج
نهایی شود. این پدیده که به اثر پروانه‌ای معروف است، بیان می‌کند که یک
تغییر کوچک در نقطه‌ی آغاز، می‌تواند پیامدهای گسترده و غیرقابل پیش‌بینی در
آینده ایجاد کند. برای مثال، ممکن است بال زدن پروانه‌ای در قاره‌ی آفریقا
باعث تغییر در جریان‌های جوی شده و در نهایت موجب} \RL{بروز طوفانی در
استرالیا شود}.

\RL{در گذشته، سیستم‌هایی که چنین رفتارهایی از خود نشان می‌دادند، به عنوان
سیستم‌های غیرقابل تحلیل از حوزه‌ی مطالعات علمی کنار گذاشته می‌شدند، زیرا
پیش‌بینی رفتار آن‌ها غیرممکن به نظر می‌رسید. با این حال، امروزه این نوع
سیستم‌ها به یکی از حوزه‌های اصلی پژوهش علمی تبدیل شده‌اند و نظریه‌ی آشوب به
عنوان ابزاری برای مطالعه‌ی پدیده‌های ظاهراً تصادفی و غیرمنظم به‌کار گرفته
می‌شود(13).}

\RL{ب) سازگاری پویا} \footnote{Dynamic Adaptation}:

\RL{سیستم‌های آشوبناک برخلاف تصور اولیه، فاقد نظم یا قانون نیستند؛ بلکه
دارای نوعی نظم درونی و پویایی سازگار هستند. این سیستم‌ها در تعامل با محیط
خود، رفتاری مشابه موجودات زنده از خود نشان می‌دهند؛ بدین معنا که قادرند
در برابر تغییرات محیطی واکنش نشان دهند و تعادل پویایی میان وضعیت درونی
خود و محیط پیرامونشان برقرار کنند. به همین دلیل، چنین سیستم‌هایی نه تنها
از بین نمی‌روند بلکه با تغییر شرایط، خود را با محیط جدید تطبیق می‌دهند
{[}14{]}.}

\RL{پ) جذب‌کننده عجیب و پیچیده} \footnote{Strange and Complex Attractor}:

\RL{در تمامی سیستم‌های دینامیکی پایدار -- چه معمولی و چه آشوبی -- مسیرهای
زمانی سیستم}\footnote{Time Series} \RL{در نهایت به سمت نقطه یا مجموعه‌ای
خاص میل می‌کنند که به آن تعادل یا جذب‌کننده}\footnote{Attractor} \RL{گفته
می‌شود. به عنوان نمونه، در یک معادله‌ی تفاضلی مرتبه اول، تمامی مسیرهای
زمانی بدون توجه به مقدار اولیه، در نهایت به سمت نقطه‌ی تعادلی در مرکز
مختصات همگرا می‌شوند. در این حالت، مرکز مختصات همان جذب‌کننده سیستم محسوب
می‌شود}.

\RL{با این حال، در بسیاری از سیستم‌های غیرخطی، جذب‌کننده‌ها ممکن است
پیچیده‌تر از یک نقطه باشند. برای مثال، جذب‌کننده می‌تواند شامل چندین ناحیه
یا مسیر بسته باشد که تمام مسیرهای زمانی سیستم در نهایت به آن‌ها گرایش
یافته و در محدوده‌ی آن‌ها باقی بمانند}.

\RL{در سیستم‌های آشوبی، جذب‌کننده‌ها بسیار پیچیده و غیرمنتظره هستند و به
همین دلیل به آن‌ها جذب‌کننده‌های عجیب}\footnote{Strange Attractors}
\RL{گفته می‌شود. این نوع جذب‌کننده‌ها معمولاً دارای ساختاری فراکتالی بوده و
از بی‌نهایت نقاط غیرقابل شمارش تشکیل شده‌اند، به‌گونه‌ای که مسیرهایی که درون
آن‌ها آغاز می‌شوند، همواره در درون آن باقی می‌مانند و مسیرهای نزدیک نیز
به‌تدریج به سمت آن جذب می‌شوند(17).}

\RL{مسیرهای زمانی موجود در جذب‌کننده‌های عجیب ممکن است غیرقابل تکرار باشند
یا به طور دلخواه در چرخه‌هایی از پیش تعیین‌شده تکرار شوند. این ویژگی باعث
می‌شود سیستم‌های آشوبی رفتاری ظاهراً تصادفی اما درواقع دارای نظم پنهان از
خود نشان دهند}.

\RL{در برخی از سیستم‌های دینامیکی غیرخطی که دارای جذب‌کننده‌های پیچیده
هستند، امکان بازسازی مسیر طی‌شده وجود دارد. این دسته از سیستم‌ها که به
سیستم‌های هامیلتونی}\footnote{Hamiltonian Systems} \RL{معروف‌اند، در صورتی
که شرایط اولیه و معادلات حرکت در دست باشد، مسیر حرکت به سمت جذب‌کننده را
می‌توان در جهت معکوس دنبال کرد. به عبارت دیگر، این سیستم‌ها از نظر زمانی
قابل بازگشت}\footnote{Time Reversible} \RL{هستند}.

\RL{اما در مقابل، در بیشتر مدل‌های آشوبی، حتی با در دست داشتن شرایط اولیه
و معادلات، بازسازی دقیق مسیر حرکتی ممکن نیست، زیرا بی‌نهایت مسیر انتقالی
متفاوت وجود دارد که به جذب‌کننده‌های مختلف منتهی می‌شوند. این غیرقابل
بازگشت بودن زمانی از ویژگی‌های اصلی سیستم‌های آشوبی محسوب می‌شود ت)
خودتشابهی} \footnote{Self-Similarity}:

\RL{یکی از ویژگی‌های بنیادین نظریه آشوب، خودتشابهی یا خودهمانندی است. این
خاصیت بیان می‌کند که در بسیاری از سیستم‌های آشوبی، الگوی کلی رفتار سیستم
در مقیاس‌های مختلف تکرار می‌شود؛ به عبارت دیگر، هر جزء کوچک از سیستم،
تصویری کوچک‌شده اما مشابه از کل آن است.}

\RL{در حوزه‌ی ریاضیات و فیزیک، این مفهوم با ساختارهای فراکتالی}
(Fractals) \RL{مرتبط است که در آن‌ها الگوها در هر مقیاسی مشابه‌اند و اگر
بخشی از شکل را بزرگ‌نمایی کنیم، همان ساختار کلی در آن دیده می‌شود. این
ویژگی باعث می‌شود که سیستم‌های آشوبی، علی‌رغم پیچیدگی ظاهری، از نظم درونی و
الگوی تکرارشونده‌ای برخوردار باشند}.

\RL{در سطح مفهومی و کاربردی، خودتشابهی را می‌توان به پدیده‌های انسانی و
سازمانی نیز تعمیم داد. به‌گونه‌ای که در یک سازمان، رفتار و جهت‌گیری هر جزء
(فرد یا واحد) می‌تواند بازتابی از ساختار کلی و هدف نهایی سازمان باشد. به
بیان دیگر، وجود خودتشابهی در رفتار اعضای یک مجموعه موجب انسجام و وحدت
هدف در کل سیستم می‌شود، به‌طوری‌که تمام اجزا در راستای یک جهت و هدف مشترک
عمل می‌کنند {[}17{]}.}

\textbf{\RL{سیستم‌های آشوب و نمای لیاپانوف}}\footnote{\textbf{Lyapunov
  Exponent}} \textbf{:}

\RL{یکی از روش‌های اساسی برای \textbf{تشخیص وجود آشوب در سیستم‌های
دینامیکی}، محاسبه‌ی \textbf{نمای لیاپانوف} است. این شاخص، \textbf{میانگین
نرخ واگرایی یا همگرایی دو مسیر بسیار نزدیک به هم در فضای فاز سیستم} را
نشان می‌دهد. در واقع، نمای لیاپانوف تعیین می‌کند که اگر دو نقطه ابتدایی
بسیار نزدیک انتخاب شوند، با گذشت زمان چگونه فاصله‌ی بین آن‌ها تغییر
می‌کند.}

\RL{مفهوم نمای لیاپانوف نخستین‌بار توسط \textbf{الکساندر لیاپانوف}،
ریاضیدان روسی، در سال} \textbf{1892 \RL{میلادی}} \RL{برای بررسی پایداری
معادلات دیفرانسیل غیرخطی ارائه شد. این روش به تحلیل پایداری سیستم‌ها
\textbf{بدون نیاز به حل تحلیلی کامل معادلات} کمک می‌کند}.

\RL{برای سیستم‌های دینامیکی غیرخطی، رفتار آن‌ها را می‌توان با استفاده از
\textbf{نگاشت‌های بازگشتی}}\footnote{\textbf{Mappings}} \RL{تحلیل کرد.
نمای لیاپانوف به‌صورت عددی از طریق دو روش اصلی، یعنی \textbf{تابع معین} و
\textbf{بعد جانشانی}، قابل محاسبه است}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{3}
\item
  \protect\hypertarget{_Toc217957728}{}{}\RL{نمونه‌هایی از سیستم‌های آشوب}
\end{enumerate}

\RL{در ادامه چند نمونه از سیستم‌های آشوبی معرفی می‌شوند}:

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957729}{}{}\RL{نگاشت لجستیک}
\end{enumerate}

\RL{نگاشت لجستیک یک نگاشت یک‌بعدی است که برای توصیف نوسانات جمعیت برخی
گونه‌های حشرات ارائه شد}:

\includegraphics[width=1.67515in,height=0.37503in]{vertopal_6a6e478acc1947c1bfecfac3523ed62b/media/image3.png}

\RL{رابطه (1-2) جمعیت در سال} n+1 \RL{} \RL{را بر اساس جمعیت سال} n
\RL{نشان می‌دهد. برای} 0 \textless{} r \textless{} \RL{، تمام مسیرها، از
هر نقطه شروع که شده باشند، پس از چند تکرار به صفر می‌رسند. برای}
1\textless r\textless3 \RL{، مسیرها پس از چند تکرار به مقدار} 1-1/r
\RL{} \RL{میل می‌کنند (شکل 2-2). از نقطه} r=3.82 \RL{به بعد، رفتار آشوبی
در نگاشت لجستیک به خوبی مشاهده می‌شود} {[}\RL{14}{]}.

\includegraphics[width=3.75866in,height=2.46688in]{vertopal_6a6e478acc1947c1bfecfac3523ed62b/media/image4.png}

\RL{شکل .2-2 نگاشت} \RL{الجستیک}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{1}
\item
  \protect\hypertarget{_Toc217957730}{}{}\RL{سیستم آشوبی
  لورنز}\footnote{Lorenz system}
\end{enumerate}

\RL{ادوارد لورنز، دانشمند هواشناس، در سال 1963 یک سیستم سه‌معادله‌ای برای
مدل‌سازی جابه‌جایی دما به صورت همرفتی در اتمسفر ارائه داد (رابطه 2-2 و شکل
3-2)}:

\includegraphics[width=1.22511in,height=0.81674in]{vertopal_6a6e478acc1947c1bfecfac3523ed62b/media/image5.png}\RL{}

\RL{رابطه (2-3) سیستم لورنز است که با مقداردهی به ثابت‌های} σ \RL{،} R
\RL{و} β \RL{به عنوان یک سیستم آشوبی، در الگوریتم‌های رمزنگاری کاربرد
دارد. این مدل امکان شبیه‌سازی ناپایداری‌ها و پیش‌بینی‌های غیرقطعی در
هواشناسی را فراهم می‌کند و به دلیل خواص دینامیکی خاص، گزینه مناسبی برای
الگوریتم‌های رمزنگاری محسوب می‌شود} {[}\RL{15،16}{]}.

\includegraphics[width=1.23344in,height=1.1251in]{vertopal_6a6e478acc1947c1bfecfac3523ed62b/media/image6.png}\RL{}

\includegraphics[width=4.80875in,height=2.45855in]{vertopal_6a6e478acc1947c1bfecfac3523ed62b/media/image7.png}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \RL{سیستم آشوبی لورنز}
\end{enumerate}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{2}
\item
  \protect\hypertarget{_Toc217957731}{}{}\RL{سیستم آشوبی چن}
\end{enumerate}

\RL{این سیستم در سال 1991 معرفی شد و با معادلات زیر نمایش داده می‌شود}
{[}\RL{17}{]}:

\includegraphics[width=1.06676in,height=1.01676in]{vertopal_6a6e478acc1947c1bfecfac3523ed62b/media/image8.png}

\RL{با مقادیر اولیه} a=35 \RL{،} b=3 \RL{،} c=28 \RL{، خروجی سیستم به
شکل (4-2) ترسیم می‌شود. لازم به ذکر است که تغییر هر یک از پارامترهای فوق
می‌تواند رفتار سیستم را از حالت آشوبی به غیرآشوبی تغییر دهد}.

\includegraphics[width=5.17545in,height=2.77524in]{vertopal_6a6e478acc1947c1bfecfac3523ed62b/media/image9.png}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \RL{سیستم آشوبی چن}
\end{enumerate}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{1}
\item
  \protect\hypertarget{_Toc217957732}{}{}\RL{ارتباط بین آشوب و رمزنگاری}
\end{enumerate}

\RL{بین سیستم‌های رمزنگاری و سیستم‌های آشوبناک رابطه‌ای بسیار نزدیک وجود
دارد و این ارتباط باعث شده است که تئوری آشوب در طراحی رمزنگاری عملی به
طور گسترده‌ای مورد استفاده قرار گیرد. نگاشت‌های آشوبناک با رفتار دینامیکی
بسیار پیچیده، کاملاً قطعی و مشخص هستند و می‌توان آن‌ها را به راحتی با
معادلات تفاضلی گسسته مدل‌سازی کرد. به همین دلیل، کارایی رمزنگاری آشوبناک
در رمزنگاری تصویر، با توجه به حجم بالای تصاویر، همبستگی پیکسل‌های مجاور و
افزونگی موجود در آن، از روش‌های متداول متقارن معمولاً بهتر است}
{[}\RL{18}{]}.\RL{}

\RL{خصوصیات دینامیکی نگاشت‌های آشوبناک با ویژگی‌های مورد نیاز یک سیستم
رمزنگاری، مانند حساسیت به کلید و متن اصلی، هم‌خوانی زیادی دارد و این
مسئله، کاربرد آشوب در رمزنگاری تصاویر را توجیه می‌کند {[}19{]}. شباهت‌های
این دو سیستم در جدول ۲-۲ ارائه شده است}.

\RL{در عمل، اغتشاش در سیستم‌های رمزنگاری متداول از طریق تبدیل متن اصلی به
متن تصادفی ایجاد می‌شود، به گونه‌ای که هیچ الگوی تکراری در متن رمز قابل
مشاهده نباشد. مشابه این، مسیر حرکت سیستم‌های آشوبناک در فضای حالت معمولاً
توزیع یکنواخت دارد و پیش‌بینی موقعیت نهایی یک نقطه بر اساس موقعیت اولیه
آن بسیار دشوار است} {[}\RL{21}{]}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \textbf{\RL{شباهت‌های سیستم‌های رمز متداول و سیستم‌های آشوبناک}}
\end{enumerate}

\begin{longtable}[]{@{}
  >{\raggedright\arraybackslash}p{(\columnwidth - 2\tabcolsep) * \real{0.6345}}
  >{\raggedright\arraybackslash}p{(\columnwidth - 2\tabcolsep) * \real{0.3655}}@{}}
\toprule()
\begin{minipage}[b]{\linewidth}\raggedright
\textbf{\RL{سیستم‌های آشوبناک}}
\end{minipage} & \begin{minipage}[b]{\linewidth}\raggedright
\textbf{\RL{سیستم‌های رمز متداول}}
\end{minipage} \\
\midrule()
\endhead
\RL{اغتشاش} (Ergodicity) & \RL{اغتشاش} (Confusion) \\
\RL{حساسیت به شرایط اولیه و پارامترهای سیستم} & \RL{انتشار}
(Diffusion) \\
\RL{شرایط اولیه و پارامترهای سیستم} & \RL{کلید رمز} \\
\RL{تکرار} & \RL{دور} (Cycle) \\
\bottomrule()
\end{longtable}

\RL{اصل مهم دیگر در طراحی یک سیستم رمزگذاری امن، ویژگی \textbf{انتشار}
است. این خاصیت بیان می‌کند که تغییر تنها یک بیت در کلید یا متن اصلی، منجر
به تولید یک متن رمز کاملاً متفاوت می‌شود. به همین ترتیب، سیستم‌های آشوبناک
شدیداً به شرایط اولیه و پارامترهای خود وابسته‌اند و کوچک‌ترین تغییر در نقطه
شروع یا پارامترها، باعث انحراف قابل توجه مسیر سیستم می‌شود}
{[}\RL{22}{]}.

\RL{تکنیک‌های اصلی رمزنگاری یک بلوک از داده‌ها شامل \textbf{اغتشاش و
انتشار} هستند. اغتشاش باعث ایجاد ابهام بین متن اصلی و متن رمز شده می‌شود
و انتشار، تغییرات را در سراسر متن رمز پخش می‌کند. جانشینی که در آن یک
نماد با نماد دیگری جایگزین می‌شود، ساده‌ترین نوع اغتشاش است. جایگشت که
ترتیب عناصر یک بلوک را تغییر می‌دهد، ساده‌ترین روش انتشار محسوب می‌شود}.

\RL{در سیستم‌های رمزنگاری، جابه‌جایی و جایگزینی متن اصلی به طور مکرر انجام
می‌شود تا سطح امنیت مطلوب حاصل شود. هر بار تکرار این عملیات را یک
\textbf{دور} می‌نامند. به شکل مشابه، در سیستم‌های دینامیکی، تکرار معادلات
تفاضلی در فضای فاز انجام می‌شود. بنابراین، می‌توان از تئوری آشوب برای
رمزنگاری بهره برد؛ به گونه‌ای که \textbf{پارامترها و شرایط اولیه سیستم
نقش کلیدی کلید رمز را ایفا کنند} و تکرار معادله آشوبناک معادل دورهای
عملکرد تابع رمز باشد} {[}\RL{23}{]}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{2}
\item
  \protect\hypertarget{_Toc217957733}{}{}\RL{پیشینه پژوهش}
\end{enumerate}

\RL{مطالعات انجام‌شده در زمینه رمزنگاری تصاویر رنگی با استفاده از
سیستم‌های آشوبی و الگوریتم‌های بهینه‌سازی در دهه‌های اخیر به‌طور گسترده‌ای
مورد توجه قرار گرفته است. در ادامه، به خلاصه‌ای از تحقیقات داخلی و خارجی
مرتبط با موضوع اشاره می‌شود}:

\RL{ژانگ و لیو{[}3{]} در مطالعه خود ترکیب سیستم‌های آشوبی} Henon Map
\RL{و} Tent Map \RL{را برای رمزنگاری تصاویر رنگی پیشنهاد دادند. نتایج
این تحقیق نشان داد که این ترکیب، امنیت بیشتری نسبت به استفاده از یک
سیستم آشوبی منفرد ارائه می‌دهد و الگوریتم پیشنهادی مقاومت خوبی در برابر
حملات آماری دارد.}

\RL{هو و ژو {[}4{]} یک مدل آشوبی نمایی (}ECM\RL{) برای تولید نگاشت‌های
آشوبی یک‌بعدی با آشوب پایدار معرفی می‌کنند. برخلاف بسیاری از سیستم‌های
آشوبی که پایداری آشوب را در نظر نمی‌گیرند،} ECM \RL{با ترکیب دو سیستم
آشوبی یک‌بعدی، نگاشت‌های جدیدی ایجاد می‌کند که در برابر تغییرات پارامتری
مقاوم‌اند. در این مقاله، نه سیستم آشوبی مبتنی بر} ECM \RL{ارائه شده و
رفتار آن‌ها از طریق دیاگرام انشعاب و تحلیل آشوب پایدار بررسی شده است.
نتایج ارزیابی عملکرد نشان می‌دهد که این نگاشت‌ها در فضای پارامتری گسترده‌ای
آشوب پایدار دارند. همچنین در کاربردهای عملی، این نگاشت‌ها در ارتباطات امن
استفاده شده و شبیه‌سازی‌ها، عملکرد برتری را در برابر نویز نشان می‌دهند.}

\RL{آلوارز و همکاران {[}6{]} به بررسی رمزنگاری تصاویر با استفاده از
سیستم آشوبی لورنز می‌پردازند. با توجه به تبادل گسترده تصاویر حاوی اطلاعات
مالی و شخصی در فضای اینترنت، حفاظت از این داده‌ها اهمیت ویژه‌ای دارد.
الگوریتم‌های رمزنگاری سنتی عمدتاً برای داده‌های متنی طراحی شده‌اند، در حالی
که داده‌های چندرسانه‌ای، به‌ویژه تصاویر، کمتر مورد توجه قرار گرفته‌اند. در
این پژوهش، روشی برای رمزنگاری و رمزگشایی تصاویر بر پایه سیستم آشوبی
لورنز ارائه شده است. در این روش، ابتدا پیکسل‌های تصویر با استفاده از
فرآیندهای جابه‌جایی و چرخش معکوس تخریب می‌شوند تا تصادفی‌بودن افزایش یابد.
سپس، الگوریتم پیشنهادی با استفاده از معادلات سه‌بعدی سیستم لورنز اجرا
می‌شود. نتایج حاصل نشان می‌دهند که میزان آنتروپی تصویر پس از رمزنگاری از
7.285 به 7.9974 افزایش یافته است. همچنین، معیارهای} NPCR \RL{و} UACI
\RL{به ترتیب 99.65٪ و 30.35٪ محاسبه شده‌اند که نشان‌دهنده قابلیت بالای
الگوریتم پیشنهادی در تأمین امنیت اطلاعات تصویری است. مقایسه این روش با
سایر تحقیقات مشابه نیز برتری آن را تأیید می‌کند.}

\RL{خدادادی و زندوکیلی {[}7{]} روشی نوین برای رمزنگاری تصاویر رنگی با
استفاده از ترکیب سیستم‌های آشوبی ارائه داده‌اند که باعث افزایش کارایی و
استحکام فرآیند رمزنگاری می‌شود. الگوریتم پیشنهادی سه سری داده در بازه 0
تا 255 را با استفاده از سیستم آشوبی چن}\footnote{Chen} \RL{تولید می‌کند.
سپس، یک سیستم چن دیگر با مقادیر اولیه متفاوت آغاز می‌شود که داده‌ها را به
سه سری مقادیر بین 0 تا 10 تبدیل می‌کند. در این روش، مقادیر قرمز، سبز و
آبی}\footnote{RGB} \RL{تصویر با داده‌های تولیدشده از سیستم اول ترکیب شده
و برای رمزنگاری اولین پیکسل تصویر استفاده می‌شود. مقادیر تولیدشده از
سیستم دوم نیز برای تغییر ترتیب ترکیب مقادیر سیستم اول با پیکسل‌های تصویر
به کار گرفته می‌شوند. این فرآیند تا رمزنگاری تمامی پیکسل‌ها ادامه می‌یابد.
نوآوری اصلی این روش در استفاده ترکیبی از دو سیستم آشوبی است که پیچیدگی
فرآیند رمزنگاری را افزایش می‌دهد}. \RL{نتایج آزمایش‌ها بر روی تصاویر
استاندارد (مجموعه داده‌های} \RL{}USC\RL{) کارایی و استحکام این روش را
نشان می‌دهد.}

\RL{پژوهش وانگ و لی {[}8{]} نشان داد که استفاده از سیستم آشوبی} Logistic
Map \RL{در ترکیب با جایگشت و انتشار، می‌تواند یک الگوریتم رمزنگاری ایمن
برای تصاویر ایجاد کند. با این حال، نیاز به بهبود کارایی محاسباتی
الگوریتم برای استفاده در کاربردهای عملی‌تر، همچنان یک چالش باقی می‌ماند.
این محدودیت می‌تواند انگیزه‌ای برای پژوهش‌های آینده باشد تا الگوریتم‌های
رمزنگاری کارآمدتر و سریع‌تری طراحی شوند.}

\RL{در پژوهش دیگری از یک سیستم رمزنگاری مبتنی بر آشوب برای رمزگذاری
تصاویر رنگی استفاده می‎شود {[}9{]}. در این روش ابتدا تصویر ورودی به
کانال‎های قرمز، سبز و آبی تفکیک شده و هر کانال به‎صورت جداگانه پردازش
می‎شود. کلیدهای رمزنگاری با استفاده از نقشه‎های آشوبی غیرخطی تولید می‎شوند
که حساسیت بالایی به شرایط اولیه دارند و کوچکترین تغییر در پارامترهای
اولیه، خروجی کاملاً متفاوتی ایجاد می‎کند. پیکسل‎های هر کانال ابتدا با
دنباله‎های آشوبی جابه‎جا شده} \RL{و سپس مقادیر آنها با عملیات} XOR \RL{و
جایگزینی دینامیکی تغییر داده می‎شود. در نهایت کانال‎های اصلاح‎شده مجدداً
ترکیب شده و تصویر رمزگذاری شده نهایی حاصل می‎شود. این سیستم با ایجاد
توزیع یکنواخت در هیستوگرام و کاهش همبستگی پیکسل‎های مجاور امنیت بالایی در
برابر حملات آماری ارائه می‎دهد}.

\RL{لی و همکاران {[}10{]} با استفاده از سیستم} \RL{آشوبی نمائی} LEL
\RL{}\footnote{Logistic-Exponential-Logistic (LEL)}\RL{، دنباله‌های
تصادفی با پیچیدگی بالا تولید کردند. نتایج پژوهش نشان داد که سیستم} LEL
\RL{در مقایسه با سیستم‌های آشوبی رایج، قابلیت بالاتری در تولید توالی‌های
غیرقابل پیش‌بینی دارد و امنیت رمزنگاری را افزایش می‌دهد.}

\RL{صادقیان {[}11{]} در پژوهشی به بررسی روش جدیدی برای رمزنگاری تصاویر
دیجیتال بر اساس ترکیب سیستم‌های آشوبی، الگوریتم ژنتیک و الگوریتم
بهینه‌سازی ازدحام ذرات} \footnote{Particle swarm optimization (PSO)}\RL{پرداخته
است. با توجه به ویژگی‌های خاص داده‌های تصویری، مانند حجم بالا و همبستگی
زیاد میان پیکسل‌های همجوار، استفاده از الگوریتم‌های رمزنگاری متنی ناکارآمد
است. در این روش، از سیستم‌های آشوبی برای ایجاد حساسیت به مقادیر اولیه و
تولید داده‌های شبه‌تصادفی استفاده شده است. همچنین، ترکیب الگوریتم ژنتیک و}
PSO \RL{به منظور بهینه‌سازی پارامترهای آشوبی و جلوگیری از جستجوی راکد
به‌کار گرفته شده است. نتایج به‌دست‌آمده از آزمایش‌های انجام‌شده بر روی
مجموعه‌ای از تصاویر استاندارد در نرم‌افزار متلب نشان می‌دهد که روش پیشنهادی
در مقایسه با روش‌های مشابه، عملکرد بهتری در حفظ جزئیات تصویری و مقاومت در
برابر حملات دارد.}

\RL{در تحقیق دیگری، یک الگوریتم رمزنگاری تصویر سریع و ایمن مبتنی بر فوق
آشوب و عملیات برداری ارائه شده است {[}12{]}. روش پیشنهادی با کاهش تعداد
تکرارهای سیستم فوق آشوب و به‌کارگیری انتخاب‌گر تصادفی، ماتریس کلیدی با
تصادفی‌بودن بالا ایجاد می‌کند. همچنین، انتشار مبتنی بر زنجیره‌سازی رمز
بلوکی با استفاده از عملیات برداری، رمزنگاری موازی تصویر را بهبود می‌بخشد.
نتایج ارزیابی نشان می‌دهند که الگوریتم پیشنهادی تمامی آزمون‌های} NIST SP
800-22 \RL{را با موفقیت گذرانده، مقدار آنتروپی آن 7.999 بوده و در برابر
حملات مختلف ایمن است. همچنین، با میانگین زمان رمزنگاری 0.023 ثانیه،
نیازهای انتقال محرمانه تصاویر را برآورده می‌کند.}

\RL{در سال 2024 یک روش نوین رمزنگاری تصویر رنگی بر پایه ترکیب سه سیستم
آشوبی} Lorenz\RL{،} Henon \RL{و 2}D-Logistic \RL{طراحی شده است {[}13{]}.
این الگوریتم به‌صورت مستقل برای هر کانال رنگی عملیات جایگشت و انتشار
انجام می‌دهد و با تحلیل‌هایی از جمله آنتروپی شانون،} NPCR \RL{و} UACI
\RL{نشان داده شد که در برابر حملات آماری و تحلیل کلید مقاومت بالایی
دارد.}

\RL{\hfill\break
}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{2}
\item
  \RL{\protect\hypertarget{_Toc217957734}{}{}معرفی الگوریتم پیشنهادی}
\end{enumerate}

\RL{\hfill\break
}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957735}{}{}\textbf{\RL{مقدمه}}
\end{enumerate}

\RL{در این فصل، به تشریح دقیق الگوریتم پیشنهادی رمزنگاری تصاویر رنگی و
نتایج تجربی آن پرداخته می‌شود. هدف این فصل، ارائه یک تصویر کامل از معماری
الگوریتم، فرآیندهای رمزنگاری و تحلیل‌های امنیتی و آماری است. نتایج
ارائه‌شده شامل تحلیل بصری تصاویر، هیستوگرام‌ها، آنتروپی، کاهش همبستگی
پیکسل‌ها، حساسیت به کلید و مقاومت در برابر حملات رمزنگاری می‌باشد. تمامی
شبیه‌سازی‌ها با استفاده از نرم‌افزار} MATLAB \RL{و تحلیل‌های عددی در محیط}
Python \RL{انجام شده است. این فصل به‌عنوان هسته تجربی پژوهش، مجموعه‌ای از
تحلیل‌های چندلایه و ارزیابی‌های کمی و کیفی را ارائه می‌کند تا میزان اثربخشی
الگوریتم رمزنگاری پیشنهادی با اتکا به شواهد عینی و نتایج عددی مورد سنجش
قرار گیرد}.

\RL{ساختار فصل بر پایه سه ستون اصلی بنا شده است}:

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \textbf{\RL{معرفی الگوریتم پیشنهادی}}
\item
  \textbf{\RL{ارائه خروجی‌های بصری برای سنجش کیفی رفتار الگوریتم}}
\item
  \textbf{\RL{تحلیل دقیق شاخص‌های آماری بنیادین رمزنگاری تصویر}}
\item
  \textbf{\RL{ارزیابی امنیتی-مقاومتی در برابر حملات آماری، دیفرانسیلی و
  ساختاری}}
\end{enumerate}

\RL{هدف از این فصل، نه تنها تأیید عملی فرضیه‌های تحقیق، بلکه نشان دادن
برتری نسبی روش پیشنهادی در مقایسه با معماری‌های مشابه مبتنی بر سیستم‌های
آشوبی است}. \RL{بنابراین، هر بخش از تحلیل‌ها به‌صورت مستقیم به یک یا چند
فرضیه پژوهش متصل شده و نشان می‌دهد چگونه اجزای الگوریتم از سطح نظری به
عملی تبدیل شده‌اند}.

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_Toc217957736}{}{}\RL{الگوریتم پیشنهادی}
\end{enumerate}

\RL{در این پژوهش، به‌منظور افزایش امنیت و پیچیدگی فرآیند رمزنگاری، از
ترکیب ۹ سیستم آشوبی نمایی به‌صورت دینامیک برای هر پیکسل استفاده شده است.
این سیستم‌ها که در مقاله پایه {[}4{]} معرفی شده‌اند، عبارتند از:}

\includegraphics[width=5.77222in,height=3.56597in]{vertopal_6a6e478acc1947c1bfecfac3523ed62b/media/image10.png}\RL{}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{1}
\item
  \protect\hypertarget{_Toc217957737}{}{}\RL{انتخاب سیستم‌های آشوبی و
  مجموعه داده}
\end{enumerate}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \textbf{\RL{انتخاب سیستم‌های آشوبی}:} \RL{به جای استفاده از یک سیستم
  آشوبی منفرد، از ۹ سیستم نمایی بالا برای رمزنگاری تصاویر استفاده شده
  است. این انتخاب باعث افزایش تصادفی بودن و پیچیدگی فرآیند رمزنگاری شده
  و امنیت الگوریتم را به طور قابل توجهی بهبود می‌بخشد}.
\item
  \textbf{\RL{انتخاب مجموعه}} \textbf{\RL{داده}: \RL{}}\RL{برای ارزیابی
  عملکرد الگوریتم، مجموعه داده استاندارد} \textbf{USC-SIPI} \RL{مورد
  استفاده قرار گرفته است. این مجموعه شامل تصاویر رنگی با ابعاد ۲۵۶×۲۵۶ و
  ۵۱۲×۵۱۲ و ویژگی‌های متنوع می‌باشد}.

  \begin{enumerate}
  \def\labelenumii{\arabic{enumii}.}
  \item
    \protect\hypertarget{_Toc217957738}{}{}\RL{فرآیند رمزنگاری}
  \end{enumerate}
\end{enumerate}

\RL{فرآیند رمزنگاری تصاویر در پنج مرحله اصلی انجام می‌شود}:

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \textbf{\RL{تولید کلیدهای اولیه}: \RL{}}\RL{مقادیر اولیه برای سیستم‌های
  آشوبی با استفاده از اعداد تصادفی انتخاب می‌شوند. این مقادیر نقش کلید
  رمزنگاری را ایفا می‌کنند و امنیت الگوریتم را تضمین می‌کنند}.
\item
  \textbf{\RL{جایگشت پیکسل‌ها با سیستم} Chen}\RL{ \textbf{:} برای شکستن
  همبستگی میان پیکسل‌ها، از سیستم} \RL{آشوبی چن برای تولید دنباله‌ای
  تصادفی استفاده می‌شود. جایگشت به گونه‌ای انجام می‌شود که موقعیت پیکسل‌ها
  در تصویر تغییر} \RL{کند}:
\end{enumerate}

